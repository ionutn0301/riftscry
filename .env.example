# Public Supabase project settings. Never put a secret/service-role key here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show only providers enabled in Supabase Auth (google,github,discord).
PUBLIC_AUTH_PROVIDERS=google

# Existing optional Riot integration (server only).
# Social sign-in is separate from Riot API approval and Riot account ownership.
RIOT_API_KEY=
RIOT_PUBLIC_ACCESS_APPROVED=false
# Keep private-testing flags off unless the deployment remains protected.
RIOT_PRIVATE_TESTING_ENABLED=false
