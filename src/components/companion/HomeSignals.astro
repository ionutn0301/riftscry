---
import { getAllPatches, getChampionMeta, getLatestPatch } from '../../lib/data';
import { buildHomeSignals } from '../../lib/home-signals';

const latest = getLatestPatch();
const signals = buildHomeSignals(getAllPatches(), getChampionMeta());
const key = (championId: string, patchId: string) => `${championId.toLowerCase()}-${patchId.replace('.', '-')}`;
const classificationLabel = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const initials = (name: string) => name.split(/\s+/).map(word => word[0]).join('').slice(0, 2).toUpperCase();
---
<section class="home-signals" data-home-signals aria-labelledby="home-signals-heading">
  <header class="home-signal-heading">
    <div><p class="home-signal-eyebrow">From the archive</p><h2 id="home-signals-heading">Small changes.<br />Worth knowing.</h2></div>
    <a class="home-signal-archive" href={`/patch/${latest.id}`}><span>Latest archived patch</span><strong>{latest.id}</strong><span aria-hidden="true">↗</span></a>
  </header>
  {signals.length > 0 ? <>
    <div class="home-signal-tabs" role="tablist" aria-label="Choose a patch example">
      {signals.map((signal, index) => <button
        type="button" class="home-signal-tab" role="tab" disabled
        id={`home-signal-tab-${key(signal.championId, signal.patchId)}`}
        aria-controls={`home-signal-panel-${key(signal.championId, signal.patchId)}`}
        aria-selected={index === 0} tabindex={index === 0 ? 0 : -1}>
        <span class="home-signal-portrait" aria-hidden="true"><span>{initials(signal.championName)}</span><img src={signal.icon} alt="" width="40" height="40" decoding="async" /></span>
        <span>{signal.championName}</span>
      </button>)}
    </div>
    <div class="home-signal-records">
      {signals.map((signal, index) => <div
        class="home-signal-panel" role="tabpanel" tabindex="0" hidden={index !== 0} inert={index !== 0} aria-hidden={index !== 0 ? 'true' : undefined}
        id={`home-signal-panel-${key(signal.championId, signal.patchId)}`}
        aria-labelledby={`home-signal-tab-${key(signal.championId, signal.patchId)}`}
        data-champion={signal.championId} data-patch={signal.patchId} data-direction={signal.direction}>
        <div class="home-signal-champion"><h3>{signal.championName}</h3><span class="home-signal-classification" data-classification={signal.classification} aria-label={`${classificationLabel(signal.classification)} champion record`}>{classificationLabel(signal.classification)}</span></div>
        <p class="home-signal-ability">{signal.ability !== 'base' && signal.ability !== 'other' && <span>{signal.ability === 'passive' ? 'P' : signal.ability}</span>}{signal.abilityName}</p>
        <p class="home-signal-label">{signal.label}</p>
        <div class="home-signal-values" data-long-values={Math.max(signal.before.length, signal.after.length) > 12}>
          <div class="home-signal-before"><span>Before</span><strong data-signal-before>{signal.before}</strong></div>
          <span class="home-signal-arrow" aria-hidden="true">→</span>
          <div class="home-signal-after"><span>After</span><strong data-signal-after>{signal.after}</strong></div>
        </div>
        {signal.unit && <p class="home-signal-unit">{signal.unit}</p>}
        <p class="home-signal-detail">{signal.abilityName} · {signal.label.toLowerCase()} changed in patch {signal.patchId}.</p>
        <div class="home-signal-links"><a class="home-signal-source" href={signal.href}>Read the full record <span aria-hidden="true">↗</span></a><a class="home-signal-original" href={signal.sourceUrl} target="_blank" rel="noreferrer">Riot’s notes <span aria-hidden="true">↗</span></a></div>
      </div>)}
    </div>
    <p class="home-signal-note">An archive example. Your briefing finds changes for champions in your own games.</p>
  </> : <p class="home-signal-note">Open the archive to explore the latest recorded champion changes.</p>}
</section>

<script>
  function initializeHomeSignals() {
    document.querySelectorAll<HTMLElement>('[data-home-signals]').forEach(root => {
      if (root.dataset.ready === 'true') return;
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      if (!tabs.length || tabs.length !== panels.length) return;
      root.querySelectorAll<HTMLImageElement>('.home-signal-portrait img').forEach(image => {
        const updatePortrait = () => {
          const loaded = image.naturalWidth > 0;
          image.hidden = !loaded;
          image.dataset.loaded = String(loaded);
        };
        image.addEventListener('load', updatePortrait);
        image.addEventListener('error', updatePortrait);
        // Cached images can finish or fail before this module initializes.
        if (image.complete) updatePortrait();
      });
      const select = (index: number, moveFocus = false) => {
        tabs.forEach((tab, tabIndex) => {
          const active = index === tabIndex;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          const panel = panels[tabIndex];
          if (panel) {
            // Inactive panels still reserve their intrinsic grid height. Keep
            // their links out of focus order and the accessibility tree.
            panel.hidden = !active;
            panel.inert = !active;
            if (active) panel.removeAttribute('aria-hidden');
            else panel.setAttribute('aria-hidden', 'true');
          }
        });
        if (moveFocus) tabs[index]?.focus({ preventScroll: true });
        const selectedPanel = panels[index];
        if (selectedPanel) root.dispatchEvent(new CustomEvent('riftscry:signal-change', {
          bubbles: true,
          detail: { championId: selectedPanel.dataset.champion, name: selectedPanel.querySelector('h3')?.textContent ?? '', index },
        }));
      };
      tabs.forEach((tab, index) => {
        tab.disabled = false;
        tab.addEventListener('click', () => select(index));
        tab.addEventListener('keydown', event => {
          let next: number;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          select(next, true);
        });
      });
      root.dataset.ready = 'true';
    });
  }
  initializeHomeSignals();
  document.addEventListener('astro:page-load', initializeHomeSignals);
</script>
