---
import { getAllPatches, getChampionMeta, getLatestPatch } from '../../lib/data';
import { buildHomeSignals } from '../../lib/home-signals';
import { assetFor } from '../../lib/investigation';
import HomeReturn from './HomeReturn';
import HomeSignals from './HomeSignals.astro';
import HomeImpact from './HomeImpact.astro';
import '../../styles/companion-home.css';
import '../../styles/observatory-home.css';

const latest = getLatestPatch();
const patchDate = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${latest.releaseDate}T00:00:00Z`));
const signals = buildHomeSignals(getAllPatches(), getChampionMeta());
const localArt: Record<string, string> = { LeeSin: '/images/observatory/LeeSin.jpg', Darius: '/images/observatory/Darius.jpg', Azir: '/images/story/Azir.jpg' };
const firstSignal = signals[0];
---
<div class="companion-home rift-cinema" data-rift-cinema data-cinema-chapter="threshold" data-signal-index="0">
  <div class="home-arrival-stage">
    <section class="home-arrival" id="home-threshold" aria-labelledby="companion-heading" data-observatory-chapter="threshold">
      <div class="home-intro">
        <div class="home-intro-copy">
          <p class="home-eyebrow"><span class="home-scry-mark" aria-hidden="true"></span> A LEAGUE OF LEGENDS OBSERVATORY</p>
          <h1 id="companion-heading"><span>The Rift</span> <em>is shifting.</em></h1>
          <p class="home-description">Every patch leaves a signal.<br />See what changed for the champions<br class="home-desktop-break" /> and builds you actually play.</p>
        </div>
        <HomeReturn client:load />
      </div>
      <a class="rift-entry" href="#home-signal" aria-label="Enter the observatory">
        <span class="rift-entry-cross" aria-hidden="true">↘</span>
        <span class="rift-entry-label">ENTER THE<br /><strong>OBSERVATORY</strong></span>
        <span class="rift-entry-arrow" aria-hidden="true">↓</span>
      </a>
      <div class="rift-perspective-hint" aria-hidden="true"><span></span>Move to change your perspective</div>
      <div class="rift-archive-label"><span>TRANSMISSION / ARCHIVED PATCH</span><a href={`/patch/${latest.id}`}>{latest.id}<span aria-hidden="true">↗</span></a><time datetime={latest.releaseDate}>{patchDate}</time></div>
      <div class="home-arrival-footer">
        <p><span class="cinema-status-light" aria-hidden="true"></span>THE GAME MOVES. <span>SEE THE CHANGE.</span></p>
        <a href="#home-signal">Follow the signal <span aria-hidden="true">↓</span></a>
        <button class="cinema-sound" type="button" data-cinema-audio aria-pressed="false" aria-label="Sound off — enable ambient sound" hidden><span class="sound-wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-audio-label>Sound off</span></button>
      </div>
    </section>
  </div>

  <div class="cinema-chapter-bar">
    <span class="chapter-bar-brand" aria-hidden="true">R / S</span>
    <nav aria-label="Observatory chapters">
      <a href="#home-signal" data-cinema-link="signal"><span>01</span> The signal</a>
      <a href="#home-impact" data-cinema-link="impact"><span>02</span> Your impact</a>
      <a href="#home-routine" data-cinema-link="next"><span>03</span> Next move</a>
    </nav>
    <button class="cinema-sound" type="button" data-cinema-audio aria-pressed="false" aria-label="Sound off — enable ambient sound" hidden><span class="sound-wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-audio-label>Sound off</span></button>
    <span class="chapter-progress" aria-hidden="true"></span>
  </div>

  <section class="cinema-signal" id="home-signal" aria-labelledby="signal-heading" data-observatory-chapter="signal">
    <header class="cinema-section-heading">
      <p class="home-eyebrow"><span>01 / THE SIGNAL</span><i aria-hidden="true"></i> CHANGE YOUR PERSPECTIVE</p>
      <h2 id="signal-heading">One Rift.<br /><em>A different reality.</em></h2>
      <p>Choose a champion. Watch the evidence change.<br />A small number can tell a different story.</p>
    </header>
    <div class="cinema-signal-grid">
      <div class="signal-aperture" data-signal-aperture>
        <div class="signal-aperture-orbit" aria-hidden="true"><i></i><i></i><span>RIFTSCRY · OBSERVATION LENS</span></div>
        {signals.map((signal, index) => <figure class="signal-art" data-signal-art={signal.championId} hidden={index !== 0}>
          <div class="signal-art-image"><img src={localArt[signal.championId] ?? assetFor(signal.championId).splash} alt={`${signal.championName} — official Riot Games artwork`} width="1215" height="717" loading="lazy" decoding="async" /><span class="signal-art-fallback" aria-hidden="true">{signal.championName}</span></div>
          <figcaption><span>OBSERVING / {String(index + 1).padStart(2, '0')}</span><strong>{signal.championName}</strong><span>RIOT GAMES ARTWORK</span></figcaption>
        </figure>)}
        {firstSignal && <a class="signal-follow" data-signal-follow href={`/explore?champion=${firstSignal.championId}#change`}>Follow <span data-signal-name>{firstSignal.championName}</span> through the archive <span aria-hidden="true">↗</span></a>}
      </div>
      <div class="home-proof">
        <div class="home-proof-coordinate"><span>THE RECORD / IN FOCUS</span><span>EXACT VALUES. ORIGINAL SOURCES.</span></div>
        <HomeSignals />
      </div>
    </div>
    <a class="cinema-next-chapter" href="#home-impact"><span>THE SIGNAL IS ONLY THE BEGINNING</span><strong>What does it change for you?</strong><span aria-hidden="true">↓</span></a>
  </section>

  <div id="home-impact" class="cinema-impact" data-observatory-chapter="impact">
    <div class="cinema-act-heading"><span>02 / YOUR IMPACT</span><span>FROM THE PATCH. INTO YOUR GAME.</span></div>
    <HomeImpact />
  </div>

  <section class="home-routine cinema-next" id="home-routine" aria-labelledby="routine-heading" data-observatory-chapter="next">
    <header class="home-section-heading"><div><p class="home-eyebrow">03 / YOUR NEXT MOVE</p><h2 id="routine-heading">The next chapter<br /><em>is yours.</em></h2></div><p>Follow the detail that matters.<br />Then get back to the game.</p></header>
    <div class="home-routine-grid">
      <a class="home-routine-card" href="/next-game#changes">
        <div class="home-routine-top"><span>01 / RETURN TO THE RIFT</span><span aria-hidden="true">↗</span></div>
        <div class="cinema-path-mark" aria-hidden="true"><svg viewBox="0 0 180 100" fill="none"><path d="M8 68h41l30-38h31l24 38h38M8 82h164M79 30V8m55 60v23"/><circle cx="79" cy="30" r="7"/><circle cx="134" cy="68" r="5"/></svg></div>
        <h3>“What did I miss?”</h3><p>Pick up after a break. See changes since your last recorded game on each champion.</p><span class="home-routine-action">Catch up on changes <span aria-hidden="true">→</span></span>
      </a>
      <a class="home-routine-card" href="/players?view=builds">
        <div class="home-routine-top"><span>02 / RETRACE A GOOD GAME</span><span aria-hidden="true">↗</span></div>
        <div class="cinema-path-mark" aria-hidden="true"><svg viewBox="0 0 180 100" fill="none"><path d="m44 20 26 30-26 30-26-30 26-30Zm46 0 26 30-26 30-26-30 26-30Zm46 0 26 30-26 30-26-30 26-30Z"/><path d="M10 50h160"/></svg></div>
        <h3>“That build felt good.”</h3><p>Rediscover the items and runes you used. The champion, the mode, the source match.</p><span class="home-routine-action">Find a recorded build <span aria-hidden="true">→</span></span>
      </a>
      <a class="home-routine-card" href="/next-game">
        <div class="home-routine-top"><span>03 / BEFORE YOU QUEUE</span><span aria-hidden="true">↗</span></div>
        <div class="cinema-path-mark" aria-hidden="true"><svg viewBox="0 0 180 100" fill="none"><circle cx="90" cy="50" r="32"/><circle cx="90" cy="50" r="19"/><path d="M90 5v20m0 50v20M40 50H12m128 0h28m-84-8 12 8-12 8"/></svg></div>
        <h3>“Okay. One more.”</h3><p>Your latest session. One useful focus. An automatic briefing built from your available games.</p><span class="home-routine-action">Open the next-game briefing <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="companion-explore cinema-epilogue" aria-labelledby="home-explore-heading">
    <div class="cinema-epilogue-art" aria-hidden="true"><img src="/images/observatory/rift-horizon.webp" alt="" width="1920" height="1081" loading="lazy" decoding="async" /></div>
    <div class="home-explore-copy"><p class="home-eyebrow">THE ARCHIVE IS A WORLD OF ITS OWN</p><h2 id="home-explore-heading">There’s always<br /><em>another perspective.</em></h2><p>Choose a champion. Follow their history.<br />See the Rift through a different lens.</p><div class="companion-explore-actions"><a class="companion-action" href="/explore">Explore the Rift <span aria-hidden="true">↗</span></a><a class="companion-text-link" href="/champions">Browse champions <span aria-hidden="true">↗</span></a></div><a class="home-archive-stamp" href={`/patch/${latest.id}`}><span>Latest archived patch <strong>{latest.id}</strong></span><span>{patchDate}<span aria-hidden="true">↗</span></span></a></div>
    <span class="epilogue-wordmark" aria-hidden="true">RIFTSCRY</span>
  </section>
</div>
<script>
  import '../../scripts/observatory-home';
</script>
