---
import type { ChampionChange } from "../lib/schema";
import type { ChampionMeta, Role } from "../lib/data";
import ClassificationBadge from "./ClassificationBadge.astro";
import SignalRecord from "./experience/SignalRecord.astro";

interface Props {
  change: ChampionChange;
  meta: ChampionMeta | undefined;
  roles: Role[];
  assetVersion: string;
  patchId?: string;
  sourceUrl?: string;
}

const { change, meta, roles, assetVersion, patchId, sourceUrl } = Astro.props;
const name = meta?.name ?? change.championId;
const title = meta?.title ?? "";
const portrait = `https://ddragon.leagueoflegends.com/cdn/${assetVersion}/img/champion/${change.championId}.png`;

---

<article
  class="change-card"
  id={change.championId.toLowerCase()}
  data-champion-id={change.championId.toLowerCase()}
  data-classification={change.classification}
  data-roles={roles.join(",")}
  data-name={name.toLowerCase()}
  data-signal-subject={change.championId}
  data-signal-name={name}
  data-signal-patch={patchId}
>
  <header class="signal-champion-heading">
    <img src={portrait} alt="" width="56" height="56" loading="lazy" decoding="async" />
    <div class="who">
      <h2><a href={`/champion/${change.championId.toLowerCase()}`}>{name}</a></h2>
      {title && <p class="title">{title}</p>}
    </div>
    <ClassificationBadge classification={change.classification} />
  </header>
  <SignalRecord label={name} championId={change.championId} patchId={patchId} sourceUrl={sourceUrl}
    inspectHref={`/champion/${change.championId.toLowerCase()}`}
    entries={change.abilities.flatMap(ability => ability.changes.map(record => ({ change:record, ability:ability.ability, abilityName:ability.name })))} />
  {change.summary && <details class="journey-source-context"><summary>Riot’s context</summary><p class="summary">{change.summary}</p></details>}
</article>

<style>
  .change-card[data-filtered="out"] { display:none; }
</style>
