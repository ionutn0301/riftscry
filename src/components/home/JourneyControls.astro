---
const chapters = [
  { label: "The threshold", beat: "opening" },
  { label: "Your champions", beat: "signal" },
  { label: "The shift", beat: "delta" },
  { label: "The echoes", beat: "history" },
  { label: "The source", beat: "source" },
];
---
<div class="journey-hud" data-journey-hud>
  <div class="journey-hud__caption"><span class="journey-hud__index" data-chapter-index>01 / 05</span><span data-chapter-name>The threshold</span></div>
  <nav class="journey-hud__chapters" aria-label="Journey chapters">
    {chapters.map((chapter, index) => <button type="button" data-chapter={chapter.beat} data-chapter-label={chapter.label} aria-label={`Chapter ${index + 1}: ${chapter.label}`} aria-current={index === 0 ? "step" : undefined}><span></span><span class="journey-hud__tooltip">{chapter.label}</span></button>)}
  </nav>
  <button type="button" class="journey-hud__sound" data-sound-toggle aria-pressed="false" aria-label="Enable ambient sound"><span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span data-sound-label>Sound off</span></button>
  <div class="journey-hud__progress" aria-hidden="true"><span data-journey-progress></span></div>
</div>
<script>
  import "../../scripts/journey-controls";
</script>
