---
interface Props {
  deltas: {
    champion: string;
    stat: string;
    patchId: string;
    before: string;
    after: string;
    direction: string;
    rel: string | null;
  }[];
}

const { deltas } = Astro.props;
---

<section class="delta-scene" data-scene="delta" aria-labelledby="delta-h">
  <div class="inner">
    <h2 id="delta-h">
      See the delta.<br />
      <span class="dim">Skip the prose.</span>
    </h2>
    <div class="pairs">
      {
        deltas.map((d) => (
          <figure class="pair" data-delta-pair>
            <p class={`values num dir-${d.direction}`}>
              <span class="before" data-delta-before>
                {d.before}
              </span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
              <span class="after" data-delta-after>
                {d.after}
              </span>
            </p>
            <figcaption>
              <span class="who">
                {d.champion} · {d.stat}
              </span>
              <span class="meta num">
                patch {d.patchId}
                {d.rel && ` · ${d.rel}`} ·
                <span class={`dir ${d.direction}`}>
                  {d.direction === "buff" ? "▲ buff" : "▼ nerf"}
                </span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .delta-scene {
    border-bottom: 1px solid var(--line);
  }

  .inner {
    max-width: 88rem;
    margin: 0 auto;
    padding: var(--s8) var(--page-pad);
  }

  h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--s7);
  }

  h2 .dim {
    color: var(--cream-dim);
  }

  .pairs {
    display: flex;
    flex-direction: column;
    gap: var(--s7);
  }

  .pair {
    margin: 0;
  }

  .values {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 4vw, 3rem);
    font-size: var(--text-colossal);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .values .before {
    color: var(--cream-faint);
    text-decoration: line-through;
    text-decoration-thickness: 0.04em;
    text-decoration-color: var(--line-strong);
  }

  .values .arrow {
    color: var(--gold);
    font-size: 0.5em;
    transform: translateY(-0.35em);
  }

  .dir-buff .after {
    color: var(--buff);
  }

  .dir-nerf .after {
    color: var(--nerf);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s5);
    margin-top: var(--s3);
    font-size: var(--text-sm);
  }

  .who {
    color: var(--cream);
    font-weight: 600;
  }

  .meta {
    color: var(--cream-faint);
  }

  .dir.buff {
    color: var(--buff);
  }

  .dir.nerf {
    color: var(--nerf);
  }
</style>
