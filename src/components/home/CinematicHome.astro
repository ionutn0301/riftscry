---
import type { ObservatoryData } from '../../lib/observatory';
import brandLogo from '../../assets/brand/logo-desktop-light.png';
import ArcaneInstrument from './ArcaneInstrument.astro';
const { data } = Astro.props as { data: ObservatoryData };
const scenes = [
 { asset: 'gateway', label: 'The observatory', title: 'A different view of the Rift.', description: 'Beyond the patch notes. Discover the changes that shape your next game.' },
 { asset: 'sanctuary', label: 'The champions', title: 'Find your constant.', description: 'Your champion. Their evolution. A clearer view of what comes next.' },
 { asset: 'archive', label: 'The archive', title: 'Every change leaves a trace.', description: 'Explore the records. Understand how the Rift arrived here.' },
];
---
<div class="cinema" data-chapter="0">
 <div class="cinema-art" aria-hidden="true"><picture><source media="(max-width: 760px)" srcset="/images/journey/gateway-mobile.webp" /><img src="/images/journey/gateway-wide.webp" width="1376" height="768" alt="" fetchpriority="high" /></picture></div>
 <header class="cinema-header"><a href="/" aria-label="RiftScry home"><img src={brandLogo.src} width="240" height="80" alt="RiftScry" /></a><a href={`/patch/${data.latest}`}>Patch {data.latest} <span aria-hidden="true">&#8599;&#65038;</span></a></header>
 <ArcaneInstrument />
 <div class="cinema-constellation" aria-label="Journey chapters">
  {scenes.map((scene, index) => <button class="constellation-node" type="button" data-chapter-button={index} aria-current={index === 0 ? 'step' : undefined} style={`--node-index:${index}`}><span class="node-line" aria-hidden="true"></span><span class="node-index">0{index + 1}</span><span class="node-label">{scene.label}</span></button>)}
 </div>
 <button class="cinema-motion" type="button" aria-pressed="false">Pause motion</button>
 <div class="cinema-content">
 {scenes.map((scene, index) => <section class="cinema-story" data-scene={scene.asset} id={`chapter-${index}`} aria-label={scene.label}>
  <p class="cinema-kicker">RIFTSCRY / {scene.label}</p><h1>{scene.title}</h1><p class="cinema-description">{scene.description}</p>
  {index === 0 ? <a class="cinema-action" href="#chapter-1">Enter the champion chamber <span aria-hidden="true">↓</span></a> : <div class="cinema-exhibit">
   <label for={`selection-${index}`}>{index === 1 ? 'Choose your champion' : 'Choose a patch'}</label>
   <select id={`selection-${index}`} aria-label={index === 1 ? 'Choose your champion' : 'Choose a patch'}>
    {index === 1 ? data.champions.map(item => <option value={`/champion/${item.id.toLowerCase()}`}>{item.name}</option>) : data.patches.map(item => <option value={`/patch/${item.id}`}>Patch {item.id}</option>)}
   </select>
   <a class="cinema-action" data-selection-link href={index === 1 ? (data.champions[0] ? `/champion/${data.champions[0].id.toLowerCase()}` : '/champions') : `/patch/${data.patches[0]?.id ?? data.latest}`}>{index === 1 ? 'Explore champion history' : 'Read the patch'} <span aria-hidden="true">&#8599;&#65038;</span></a>
  </div>}
 </section>)}
 </div>
 <footer class="cinema-footer"><nav aria-label="Explore the observatory">{scenes.map((scene, index) => <button type="button" data-chapter-button={index} aria-current={index === 0 ? 'step' : undefined}><span class="cinema-number">0{index + 1}</span><span>{scene.label}</span></button>)}</nav><a class="cinema-all" href="/champions">All champions <span aria-hidden="true">&#8599;&#65038;</span></a></footer>
 <p class="cinema-disclaimer">An independent League of Legends observatory. Not endorsed by Riot Games.</p>
</div>
<script>
 const root = document.querySelector<HTMLElement>('.cinema');
 if (root) {
  const motion = root.querySelector<HTMLButtonElement>('.cinema-motion')!;
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const setPaused = (paused: boolean) => {
   root.dataset.motion = paused ? 'paused' : 'playing';
   motion.setAttribute('aria-pressed', String(paused));
   motion.textContent = paused ? 'Resume motion' : 'Pause motion';
  };
  setPaused(preference.matches);
  preference.addEventListener('change', () => setPaused(preference.matches));
  motion.addEventListener('click', () => setPaused(root.dataset.motion !== 'paused'));
  document.addEventListener('visibilitychange', () => root.classList.toggle('cinema-inactive', document.hidden));
  root.addEventListener('pointermove', event => {
   if (event.pointerType !== 'mouse' || preference.matches || root.dataset.motion === 'paused') return;
   root.style.setProperty('--tilt-x', `${(event.clientX / innerWidth - .5) * 12}deg`);
   root.style.setProperty('--tilt-y', `${(event.clientY / innerHeight - .5) * -8}deg`);
  }, { passive: true });
  root.addEventListener('pointerleave', () => { root.style.setProperty('--tilt-x', '0deg'); root.style.setProperty('--tilt-y', '0deg'); });
  const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
  const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.constellation-node'));
  buttons.forEach((button, index) => button.addEventListener('click', () => {
   panels[index]?.scrollIntoView({ behavior: preference.matches ? 'instant' : 'smooth', block: 'start' });
  }));
  root.addEventListener('keydown', event => {
   if (!['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft'].includes(event.key)) return;
   event.preventDefault();
   const current = Number(root.dataset.chapter ?? 0);
   const direction = event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : -1;
   panels[Math.max(0, Math.min(panels.length - 1, current + direction))]?.scrollIntoView({ behavior: preference.matches ? 'instant' : 'smooth', block: 'start' });
  });
  let scheduled = false;
  const updateJourney = () => {
   scheduled = false;
   const progress = Math.max(0, Math.min(2, -root.getBoundingClientRect().top / innerHeight));
   const chapter = Math.min(2, Math.round(progress));
   root.dataset.chapter = String(chapter);
   root.style.setProperty('--travel', String(progress));
   const moving = !preference.matches && root.dataset.motion !== 'paused';
   const camera = moving ? progress : chapter;
   root.style.setProperty('--camera-scale', String(1 + Math.sin(camera * Math.PI / 2) * 2.2));
   root.style.setProperty('--camera-turn', `${camera * 110 - 22}deg`);
   root.style.setProperty('--camera-x', `${Math.sin(camera * Math.PI) * -18}vw`);
   root.style.setProperty('--journey-progress', `${progress / 2 * 100}%`);
   buttons.forEach((item, i) => { if (i === chapter) item.setAttribute('aria-current', 'step'); else item.removeAttribute('aria-current'); });
  };
  const schedule = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(updateJourney); } };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  motion.addEventListener('click', schedule);
  preference.addEventListener('change', schedule);
  updateJourney();
  root.querySelectorAll<HTMLSelectElement>('select').forEach(select => select.addEventListener('change', () => {
   const link = select.parentElement?.querySelector<HTMLAnchorElement>('[data-selection-link]');
   if (link && select.value.startsWith('/')) link.href = select.value;
  }));
 }
</script>
