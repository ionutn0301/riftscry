---
import type { ChampionMeta } from "../../lib/data";

interface Props {
  exemplar: string[];
  fieldIds: string[];
  meta: Record<string, ChampionMeta>;
  assetVersion: string;
  exemplarChanges: number;
}

const { exemplar, fieldIds, meta, assetVersion, exemplarChanges } = Astro.props;
const portrait = (id: string) =>
  `https://ddragon.leagueoflegends.com/cdn/${assetVersion}/img/champion/${id}.png`;
---

<section class="yours" data-scene="yours" aria-labelledby="yours-h">
  <div class="inner">
    <div class="field" aria-hidden="true" data-yours-field>
      {
        fieldIds.map((id) => (
          <span class={`tile ${exemplar.includes(id) ? "picked" : ""}`} data-yours-tile>
            <img src={portrait(id)} alt="" width="72" height="72" loading="lazy" decoding="async" />
            {exemplar.includes(id) && <span class="tag">{meta[id]?.name ?? id}</span>}
          </span>
        ))
      }
    </div>
    <div class="caption">
      <h2 id="yours-h">
        <span class="num stat">{exemplar.length}</span> champions.<br />
        <span class="num stat gold">{exemplarChanges}</span> relevant changes all season.
      </h2>
      <p class="sub">
        Your pool lives in your browser — no account, no tracking. Every patch page bends
        around it.
      </p>
      <a class="cta" href="/pool">Build your pool →</a>
    </div>
  </div>
</section>

<style>
  .yours {
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .inner {
    max-width: 88rem;
    margin: 0 auto;
    padding: var(--s8) var(--page-pad);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--s7);
    align-items: center;
  }

  .field {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s3);
  }

  .tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--line);
    filter: saturate(0.15) brightness(0.55);
    transition: filter var(--t-med) var(--ease-out);
  }

  .tile.picked img {
    filter: saturate(1) brightness(1);
    border-color: var(--gold);
    box-shadow: 0 0 0 1px var(--gold);
  }

  .tile.picked {
    transform: scale(1.12);
    z-index: 1;
  }

  .tag {
    position: absolute;
    left: 50%;
    bottom: -0.4rem;
    transform: translate(-50%, 100%);
    background: var(--ink);
    border: 1px solid var(--gold-deep);
    color: var(--gold-bright);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 1px 6px;
    white-space: nowrap;
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 550;
    line-height: 1.25;
    margin-bottom: var(--s4);
  }

  .stat {
    font-size: 1.4em;
    font-weight: 500;
  }

  .gold {
    color: var(--gold-bright);
  }

  .sub {
    color: var(--cream-dim);
    max-width: 38ch;
    line-height: 1.7;
    margin-bottom: var(--s5);
  }

  .cta {
    color: var(--gold-bright);
    font-weight: 600;
  }

  .cta:hover {
    color: var(--cream);
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }

    .field {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--s2);
    }
  }
</style>
