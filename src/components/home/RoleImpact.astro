---
interface Props {
  patchId: string;
  roleCounts: {
    role: string;
    buffs: number;
    nerfs: number;
    adjusted: number;
    champions: string[];
  }[];
}

const { patchId, roleCounts } = Astro.props;
const LABEL: Record<string, string> = {
  top: "Top",
  jungle: "Jungle",
  mid: "Mid",
  adc: "ADC",
  support: "Support",
};
---

<section class="rolescene" data-scene="roles" aria-labelledby="roles-h">
  <div class="inner">
    <h2 id="roles-h">Your lane felt it too.</h2>
    <ul class="roles" data-roles-list>
      {
        roleCounts.map((r) => (
          <li data-role-row>
            <a href={`/patch/${patchId}?role=${r.role}`}>
              <span class="role-name">{LABEL[r.role]}</span>
              <span class="counts num">
                <span class="c buff" title="buffs">
                  ▲ {r.buffs}
                </span>
                <span class="c nerf" title="nerfs">
                  ▼ {r.nerfs}
                </span>
                <span class="c adj" title="adjusted">
                  ◆ {r.adjusted}
                </span>
              </span>
              <span class="go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="note">Counts from patch {patchId}, via the curated role mapping.</p>
  </div>
</section>

<style>
  .rolescene {
    border-bottom: 1px solid var(--line);
  }

  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--s8) var(--page-pad);
  }

  h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--s6);
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .roles a {
    display: flex;
    align-items: baseline;
    gap: var(--s5);
    padding: var(--s4) 0;
    border-top: 1px solid var(--line);
    transition: background-color var(--t-fast) var(--ease-out);
  }

  .roles li:last-child a {
    border-bottom: 1px solid var(--line);
  }

  .roles a:hover {
    background: var(--ink-2);
    color: inherit;
  }

  .role-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 550;
    letter-spacing: 0.02em;
    min-width: 5.5ch;
  }

  .counts {
    display: inline-flex;
    gap: var(--s5);
    font-size: var(--text-lg);
    margin-left: auto;
  }

  .c.buff {
    color: var(--buff);
  }

  .c.nerf {
    color: var(--nerf);
  }

  .c.adj {
    color: var(--neutral);
  }

  .go {
    color: var(--cream-faint);
    font-size: var(--text-lg);
  }

  .roles a:hover .go {
    color: var(--gold-bright);
  }

  .note {
    margin-top: var(--s4);
    font-size: var(--text-xs);
    color: var(--cream-faint);
  }

  @media (max-width: 640px) {
    .counts {
      gap: var(--s3);
      font-size: var(--text-base);
    }
  }
</style>
