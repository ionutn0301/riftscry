---
interface Props {
  patchId: string;
}

const { patchId } = Astro.props;
---

<section class="closing" data-scene="closing" aria-labelledby="closing-h">
  <div class="inner">
    <h2 id="closing-h" data-closing-line>Queue informed.</h2>
    <div class="ctas">
      <a class="cta solid" href={`/patch/${patchId}`}>View current patch</a>
      <a class="cta ghost" href="/pool">Choose my champions</a>
    </div>
  </div>
</section>

<style>
  .closing {
    display: grid;
    place-items: center;
    min-height: 70svh;
    text-align: center;
  }

  .inner {
    padding: var(--s8) var(--page-pad);
  }

  h2 {
    font-size: var(--text-display);
    font-weight: 600;
    margin-bottom: var(--s6);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s3);
  }

  .cta {
    padding: var(--s3) var(--s5);
    font-weight: 600;
    font-size: var(--text-sm);
    border-radius: 2px;
    transition:
      background-color var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out),
      color var(--t-fast) var(--ease-out);
  }

  .cta.solid {
    background: var(--gold);
    color: var(--ink);
  }

  .cta.solid:hover {
    background: var(--gold-bright);
    color: var(--ink);
  }

  .cta.ghost {
    border: 1px solid var(--line-strong);
    color: var(--cream);
  }

  .cta.ghost:hover {
    border-color: var(--gold-deep);
    color: var(--gold-bright);
  }
</style>
