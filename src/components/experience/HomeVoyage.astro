---
import { buildJourneyModel, journeyRoster } from '../../lib/voyage-data';
import { voyageConnection } from '../../lib/voyage-state';
import { getLatestPatch, getAllPatches } from '../../lib/data';
import '../../styles/signal-readers.css';
import '../../styles/signal-explore.css';
const latest = getLatestPatch();
const exampleId = latest.champions.find(champion => champion.abilities.some(ability => ability.changes.length))?.championId ?? 'Belveth';
const model = buildJourneyModel(exampleId)!;
const roster = journeyRoster();
const archive = getAllPatches();
const featured = [...new Set([exampleId, 'Belveth', 'Azir', 'Ahri'])].map(id => roster.find(champion => champion.id === id)!);
const initial = model.records.find(record => record.id === model.selectedId);
const initialTrail = model.records.filter(record => record.field === initial?.field && model.periodIds.includes(record.id));
const initialFields = [...new Map(model.records.filter(record => model.periodIds.includes(record.id)).map(record => [record.field, record])).values()];
const safeModel = JSON.stringify(model).replaceAll('<', '\\u003c');
---
<div class="rift-voyage voyage-station" data-voyage data-chapter="2" data-journey-deck data-journey-default="change">
  <header class="voyage-station-heading">
    <div><p class="journey-eyebrow">FOLLOW YOUR SIGNAL</p><h1>Look closer.</h1></div>
    <div class="voyage-perspective-controls">
      <div class="quick-perspectives" role="group" aria-label="Featured champion perspectives">{featured.map(champion => <button type="button" data-choose-champion={champion.id} aria-pressed={champion.id === model.identity.id}><img src={champion.icon} alt="" width="40" height="40" loading="lazy" decoding="async" /><span>{champion.name}</span></button>)}</div>
      <button type="button" class="voyage-action voyage-action--outline" data-roster-open>Find your champion <span aria-hidden="true">↗</span></button>
    </div>
    <p class="perspective-status" role="status" data-selection-status>Following {model.identity.name}.</p>
  </header>

  <section id="change" class="voyage-station-scene" data-journey-panel data-journey-label="The change" data-journey-world="explore" data-journey-chapter="2">
    <span id="arrival" class="voyage-legacy-anchor" aria-hidden="true"></span><span id="perspective" class="voyage-legacy-anchor" aria-hidden="true"></span>
    <div class="voyage-inspection">
      <figure class="perspective-identity" data-champion-identity>
        <picture><source media="(max-width:700px)" srcset={model.identity.portrait} data-champion-portrait /><img src={model.identity.splash} alt={model.identity.name + ' — official Riot Games artwork'} width="1215" height="717" loading="eager" decoding="async" data-champion-splash /></picture>
        <div class="champion-art-fallback" data-art-fallback hidden>Artwork unavailable. The records remain available.</div>
        <figcaption><div><p class="journey-eyebrow">YOUR PERSPECTIVE</p><h2 data-champion-name>{model.identity.name}</h2><p data-champion-title>{model.identity.title}</p></div><button type="button" class="champion-save" data-save-champion aria-pressed="false">Save to My Pool <span aria-hidden="true">+</span></button></figcaption>
        <small class="voyage-art-credit">RIOT GAMES ARTWORK</small>
      </figure>
      <div class="voyage-evidence-desk" data-signal-lens>
        <div class="change-choice"><label for="voyage-field">Recorded change</label><select id="voyage-field" data-field-choice>{initialFields.map(record => <option value={record.field} selected={record.field === initial?.field}>{record.ability === 'base' ? 'Base stats' : record.ability} / {record.change.label}</option>)}</select></div>
        <article class="voyage-record signal-record" data-current-record data-signal-record="0" data-signal-side="after" style="--signal-focus:1">
          <p class="record-context"><span data-record-champion>{model.identity.name}</span><span data-record-patch>PATCH {initial?.patch}</span><time data-record-date>{initial?.date}</time><span data-record-ability>{initial?.abilityName}</span></p>
          <h3 data-record-label>{initial?.change.label}</h3>
          <div class="record-values signal-aperture delta-row" data-record-numeric hidden={initial?.change.kind !== 'numeric'} data-long={initial?.change.kind === 'numeric' && (initial.change.before.length > 18 || initial.change.after.length > 18)}><div class="record-before signal-value signal-value--before"><span>Before</span><strong data-record-before>{initial?.change.kind === 'numeric' ? initial.change.before : ''}</strong></div><span class="record-crossing signal-crossing" aria-hidden="true"><i></i><b>→</b><i></i></span><div class="record-after signal-value signal-value--after"><span>After</span><strong data-record-after>{initial?.change.kind === 'numeric' ? initial.change.after : ''}</strong></div></div>
          <div class="signal-scrub" data-signal-scrub hidden><button type="button" data-signal-set="0" aria-pressed="false">Before</button><input type="range" min="0" max="100" value="100" data-signal-range aria-label="Focus before or after the change" data-before-value={initial?.change.kind === 'numeric' ? initial.change.before : ''} data-after-value={initial?.change.kind === 'numeric' ? initial.change.after : ''} /><button type="button" data-signal-set="100" aria-pressed="true">After</button></div>
          <p class="record-rule" data-record-prose hidden={initial?.change.kind !== 'prose'}>{initial?.change.kind === 'prose' ? initial.change.text : ''}</p>
          <p class="record-unit" data-record-unit>{initial?.change.kind === 'numeric' ? initial.change.unit : ''}</p>
          <details class="voyage-reading-detail"><summary>Reading this record</summary><p class="record-reading" data-record-reading>{initial?.reading}</p></details>
          <div class="record-quiet" data-record-quiet hidden><h3>No direct record.</h3><p>This champion has no direct record in the selected interval.</p><a class="voyage-text-link" data-historical-recovery hidden></a><a class="voyage-text-link" href="/patches">Open the archive ↗</a></div>
          <div class="voyage-actions"><button type="button" class="voyage-action voyage-action--outline" data-focus-record aria-pressed="false">Keep this finding <span aria-hidden="true">+</span></button><a class="voyage-text-link" data-record-source href={initial?.source ?? latest.sourceUrl} target="_blank" rel="noreferrer">Original source ↗</a></div>
          <p class="finding-explanation" role="status" data-findings-status></p>
        </article>
        <a class="voyage-station-continue" href="#history"><span>Follow this field through time</span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="history" class="voyage-station-scene" data-journey-panel data-journey-label="Through time" data-journey-world="patches" data-journey-chapter="3">
    <div class="voyage-time-desk">
      <header><p class="journey-eyebrow">THE SAME FIELD / THROUGH TIME</p><h2>Follow the<br /><em>aftershocks.</em></h2></header>
      <div class="history-controls"><label>After patch<select data-period-older aria-label="After patch">{archive.map(patch => <option selected={patch.id === model.older}>{patch.id}</option>)}</select></label><span aria-hidden="true">→</span><label>Through patch<select data-period-newer aria-label="Through patch">{archive.map(patch => <option selected={patch.id === model.newer}>{patch.id}</option>)}</select></label><a class="voyage-text-link" data-compare-link href={'/compare/' + model.newer + '/' + model.older}>Compare interval ↗</a></div>
      <p class="history-validation" role="status" data-period-status>Starting patch excluded. Ending patch included.</p>
      <div class="history-trace" data-history-trace aria-label="Records for the selected field">{initialTrail.map(record => <button type="button" class="history-stop" data-select-record={record.id} aria-pressed={record.id === initial?.id}><span class="history-pin" aria-hidden="true"></span><time>{record.date}</time><strong>{record.patch}</strong><span>{record.change.kind === 'numeric' ? record.change.before + ' → ' + record.change.after : record.change.label}</span></button>)}</div>
      <div class="trace-reading"><span class="journey-eyebrow" data-trace-caption>{initial?.change.label}</span><p class="trace-connection" data-trace-connection>{voyageConnection(initialTrail)}</p><p data-trace-description>Exact archived records for the same field.</p><div class="voyage-actions"><a class="voyage-action voyage-action--outline" href="#change">Inspect this record <span aria-hidden="true">↗</span></a><button type="button" class="voyage-text-link" data-keep-trace aria-pressed="false">Keep this finding <span aria-hidden="true">+</span></button><a class="voyage-text-link" data-trace-source href={initial?.source ?? latest.sourceUrl} target="_blank" rel="noreferrer">Original source ↗</a></div></div>
      <a class="voyage-text-link" data-champion-link href={'/champion/' + model.identity.id.toLowerCase()}>Complete champion history ↗</a>
    </div>
  </section>

  <section id="return" class="voyage-station-scene" data-journey-panel data-journey-label="Keep a finding" data-journey-world="pool" data-journey-chapter="4">
    <div class="voyage-kept-desk"><p class="journey-eyebrow">YOUR TRAIL / SAVED ON THIS DEVICE</p><h2>Keep what<br /><em>matters to you.</em></h2><p data-return-perspective>Keep {model.identity.name} close.</p><div class="voyage-actions"><button type="button" class="voyage-action" data-save-champion aria-pressed="false">Save to My Pool <span aria-hidden="true">+</span></button><a class="voyage-text-link" href="/pool#findings">Open kept findings ↗</a></div><div class="journey-findings" data-journey-findings hidden><h3>Findings you kept</h3><ul data-findings-list></ul></div><a class="voyage-station-continue" href="/next-game"><span>Continue to your automatic briefing</span><span aria-hidden="true">↗</span></a></div>
  </section>

  <dialog class="voyage-roster-dialog" id="voyage-roster" data-roster-featured={featured.map(champion => champion.id).join(",")} aria-labelledby="voyage-roster-title"><div class="voyage-roster-shell"><header><div><p class="journey-eyebrow">CHOOSE YOUR PERSPECTIVE</p><h2 id="voyage-roster-title">Who are you here for?</h2></div><button type="button" class="world-close" data-roster-close aria-label="Close champion selection">Close <span aria-hidden="true">×</span></button></header><div class="roster-search-row"><label for="voyage-roster-query">Find a champion<input id="voyage-roster-query" type="search" autocomplete="off" placeholder="Name your champion…" data-roster-query /></label><label for="voyage-roster-role">Role<select id="voyage-roster-role" data-roster-role><option value="">All roles</option><option value="top">Top</option><option value="jungle">Jungle</option><option value="mid">Mid</option><option value="adc">Bot</option><option value="support">Support</option></select></label></div><p role="status" data-roster-status>Choose a champion to follow.</p><ul class="voyage-roster-results" data-roster-results></ul><footer><span>{roster.length} perspectives.</span><a href="/champions">Full roster ↗</a></footer></div></dialog>
  <script is:inline type="application/json" id="voyage-initial-data" set:html={safeModel}></script>
  <noscript><p class="voyage-nojs">All source records remain available. <a href="/champions">Choose another champion</a> or <a href="/patches">open the patch archive</a>.</p></noscript>
</div>
<script>
  import '../../scripts/voyage';
  import '../../scripts/signal-record';
</script>
