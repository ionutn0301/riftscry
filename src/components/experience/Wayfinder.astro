---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-desktop-light.png';
import { getLatestPatch } from '../../lib/data';

interface Props { surface: string }
const { surface } = Astro.props;
const latest = getLatestPatch();
const destinations = [
  { id: 'players', label: 'Recent games', description: 'Find a player. Review a match.', href: '/players' },
  { id: 'next-game', label: 'Next game', description: 'Your personal patch briefing.', href: '/next-game' },
  { id: 'pool', label: 'My Pool', description: 'Keep your champions close.', href: '/pool' },
  { id: 'champions', label: 'Champions', description: 'Find a champion’s history.', href: '/champions' },
  { id: 'patches', label: 'Patch archive', description: 'Every recorded change.', href: '/patches' },
  { id: 'compare', label: 'Compare', description: 'See what changed between patches.', href: '/compare' },
  { id: 'explore', label: 'The journey', description: 'Step inside the observatory.', href: '/explore' },
  { id: 'notebook', label: 'Notebook', description: 'Your saved notes and builds.', href: '/notebook' },
];
const isPlayerArea = ['players', 'player', 'match'].includes(surface);
const active = isPlayerArea ? 'players' : surface === 'champion' ? 'champions' : surface === 'patch' ? 'patches' : surface;
---
<header class:list={['world-controls', 'world-controls--tasks', { 'world-controls--player': isPlayerArea }]} aria-label="RiftScry controls">
  <a class="world-brand" href="/" aria-label="RiftScry home"><Image src={logo} alt="RiftScry" height={48} densities={[1, 2]} loading="eager" /></a>
  <nav class="world-task-links" aria-label="Main tasks">
    <a href="/players" aria-current={isPlayerArea ? 'page' : undefined}>Games</a>
    <a href="/next-game" aria-current={surface === 'next-game' ? 'page' : undefined}>Next game</a>
    <a href="/pool#briefing" aria-current={surface === 'pool' ? 'page' : undefined}>Champion changes</a>
  </nav>
  <div class="world-utilities">
    <div class="wayfinder-dock">
      <button type="button" class="world-search player-map-trigger" data-map-open aria-haspopup="dialog" aria-controls="rift-map-dialog" aria-label="Open the Rift map" aria-keyshortcuts="Alt+M"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 2 9 10-9 10L3 12 12 2Zm0 5 4 5-4 5-4-5 4-5Z" stroke="currentColor" /></svg><span>Rift map</span></button>
    </div>
    <button type="button" class="world-search" data-palette-trigger aria-label="Search the archive">Search <kbd>⌘ K</kbd></button>
    <button type="button" class="motion-choice" data-motion-toggle aria-pressed="false" aria-label="Reduce motion"><span aria-hidden="true">◐</span><span data-motion-label>Motion on</span></button>
  </div>
</header>

<dialog id="rift-map-dialog" class="world-map-dialog" aria-labelledby="rift-map-title">
  <div class="map-dialog-inner">
    <header class="map-dialog-heading"><div><p class="world-eyebrow">RIFTSCRY / OBSERVATORY</p><h2 id="rift-map-title">Where next?</h2></div><button type="button" class="world-close" data-map-close aria-label="Close the Rift map">Close <span aria-hidden="true">×</span></button></header>
    <nav class="navigation-landscape" aria-label="RiftScry destinations">
      {destinations.map((destination, index) => <a class="map-destination" href={destination.href} aria-current={active === destination.id ? 'page' : undefined}>
        <span class="destination-coordinate">0{index + 1}<i aria-hidden="true"></i></span><strong>{destination.label}</strong><span>{destination.id === 'pool' ? <><span data-world-pool-count>0</span> champions saved on this device.</> : destination.description}</span><b aria-hidden="true">↗</b>
      </a>)}
    </nav>
    <footer class="map-dialog-footer"><span>Archive through {latest.releaseDate}</span><button type="button" data-palette-trigger>Search the archive <span aria-hidden="true">⌘ K / Ctrl K</span></button></footer>
  </div>
</dialog>
<noscript><nav class="world-nojs-nav" aria-label="RiftScry destinations">{destinations.map((destination) => <a href={destination.href}>{destination.label}</a>)}</nav></noscript>
