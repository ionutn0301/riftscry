---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-desktop-light.png';
import { getLatestPatch } from '../../lib/data';

interface Props { surface: string }
const { surface } = Astro.props;
const latest = getLatestPatch();
const destinations = [
  { id: 'home', label: 'The journey', description: 'Find your way through a changing game.', href: '/', x: 16, y: 72 },
  { id: 'champions', label: 'Champions', description: 'Every identity. Their recorded history.', href: '/champions', x: 33, y: 27 },
  { id: 'patches', label: 'Patch archive', description: 'Read the changes at their source.', href: '/patches', x: 54, y: 53 },
  { id: 'compare', label: 'Compare', description: 'Put two moments side by side.', href: '/compare', x: 75, y: 22 },
  { id: 'pool', label: 'My Pool', description: 'Your champions. Your next briefing.', href: '/pool', x: 83, y: 76 },
];
const active = surface === 'champion' ? 'champions' : surface === 'patch' ? 'patches' : surface;
const label = destinations.find((destination) => destination.id === active)?.label ?? 'Find your way';
---
<div class="world-controls" aria-label="RiftScry controls">
  <a class="world-brand" href="/" aria-label="RiftScry home"><Image src={logo} alt="RiftScry" height={48} densities={[1, 2]} loading="eager" /></a>
  <div class="world-location"><span class="location-dot" aria-hidden="true"></span><span data-current-location>{label}</span></div>
  <div class="world-utilities">
    <a href="/players">Players</a>
    <button type="button" class="world-search" data-palette-trigger>Search <kbd>⌘ K</kbd></button>
    <button type="button" class="motion-choice" data-motion-toggle aria-pressed="false" aria-label="Reduce motion"><span aria-hidden="true">◐</span><span data-motion-label>Motion on</span></button>
  </div>
</div>

<div class="wayfinder-dock">
  <button type="button" class="wayfinder-trigger" data-map-open aria-haspopup="dialog" aria-controls="rift-map-dialog" aria-label="Open the Rift map" aria-keyshortcuts="Alt+M">
    <svg class="mini-world" viewBox="0 0 140 92" fill="none" aria-hidden="true">
      <path class="mini-contour" d="m10 62 21-45 38-8 57 24 7 35-40 16-53-2zM21 60l17-34 29-8 49 20 6 23-31 14-44-1zM36 56l12-21 23-5 31 12 6 16-22 8-32-2z"/>
      <path class="mini-route" d="m23 66 23-41 30 24 30-28 10 49"/>
      {destinations.map((destination) => <circle cx={destination.x * 1.35} cy={destination.y} r={active === destination.id ? 4 : 2.4} class:list={['mini-point', { 'is-current': active === destination.id }]} />)}
    </svg>
    <span><strong>Rift map</strong><small>Choose your destination <kbd title="Alt+M / Option+M">Alt M</kbd></small></span><span class="map-open-mark" aria-hidden="true">↗</span>
  </button>
  <a class="briefing-shortcut" href="/pool#briefing" aria-label="Open your champion briefing">Your briefing <span data-world-pool-count>0</span><span aria-hidden="true">↗</span></a>
</div>

<dialog id="rift-map-dialog" class="world-map-dialog" aria-labelledby="rift-map-title">
  <div class="map-dialog-inner">
    <header class="map-dialog-heading"><div><p class="world-eyebrow">RIFTSCRY / FIND YOUR WAY</p><h2 id="rift-map-title">A different way<br />through the game.</h2></div><button type="button" class="world-close" data-map-close aria-label="Close the Rift map">Close <span aria-hidden="true">×</span></button></header>
    <nav class="navigation-landscape" aria-label="RiftScry destinations">
      <svg viewBox="0 0 1000 430" preserveAspectRatio="none" aria-hidden="true" class="navigation-terrain">
        <path class="terrain-contour" d="M50 310 170 100 420 40 780 90 950 280 760 410 360 400Z M120 300 220 150 440 90 730 130 860 270 710 355 370 350Z M200 285 290 200 460 150 690 180 770 260 670 310 410 300Z"/>
        <path class="terrain-route" d="M160 310 C220 285 270 145 330 115 S480 255 540 228 675 74 750 95 800 258 830 327" />
      </svg>
      {destinations.map((destination, index) => <a class="map-destination" href={destination.href} aria-current={active === destination.id ? 'page' : undefined} style={`--map-x:${destination.x}%;--map-y:${destination.y}%;--map-order:${index}`}>
        <span class="destination-coordinate">0{index + 1}<i aria-hidden="true"></i></span><strong>{destination.label}</strong><span>{destination.description}</span><b aria-hidden="true">↗</b>
      </a>)}
    </nav>
    <footer class="map-dialog-footer"><span>Archive through {latest.releaseDate}</span><button type="button" data-palette-trigger>Search champions, patches, items <span aria-hidden="true">⌘ K / Ctrl K</span></button><span>Choose a place. Make it yours.</span></footer>
  </div>
</dialog>
<noscript><nav class="world-nojs-nav" aria-label="RiftScry destinations">{destinations.map((destination) => <a href={destination.href}>{destination.label}</a>)}</nav></noscript>
