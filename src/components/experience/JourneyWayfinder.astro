---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-desktop-light.png';
import { journeyStations, stationForSurface } from '../../lib/journey-stations';
import { getAllPatches } from '../../lib/data';
import RiftAtlas from './RiftAtlas.astro';
interface Props { surface: string }
const { surface } = Astro.props;
const active = stationForSurface(surface);
const section = ['players', 'next-game'].includes(active) ? 'game' : active === 'pool' ? 'saved' : 'discover';
const patches = getAllPatches();
const compareHref = patches.length > 1 ? `/compare/${patches[0]!.id}/${patches[1]!.id}` : '/patches';
---
<header class="world-controls journey-header" aria-label="RiftScry controls">
  <a class="world-brand" href="/" aria-label="RiftScry home"><Image src={logo} alt="RiftScry" height={40} densities={[1, 2]} loading="eager" /></a>
  <nav class="journey-primary" aria-label="Main navigation">
    <a href="/" aria-current={section === 'discover' ? 'page' : undefined}>Discover</a>
    <a href="/next-game" data-station-link="next-game" aria-current={section === 'game' ? 'page' : undefined}>My game</a>
    <a href="/pool" aria-current={section === 'saved' ? 'page' : undefined}>Saved <span data-signal-saved-count aria-hidden="true" hidden>0</span></a>
  </nav>
  <div class="world-utilities">
    <button type="button" class="journey-search-trigger" data-palette-trigger aria-label="Search the archive"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><kbd>⌘ K</kbd></button>
    <button type="button" class="motion-choice" data-motion-toggle aria-pressed="false" aria-label="Reduce motion"><span aria-hidden="true">◐</span><span data-motion-label class="sr-only">Motion on</span></button>
    <button type="button" class="journey-map-trigger" data-map-open aria-haspopup="dialog" aria-controls="rift-map-dialog" aria-label="Open the Rift map" aria-keyshortcuts="Alt+M"><span class="journey-menu-mark" aria-hidden="true"><i></i><i></i></span><span>Rift atlas</span></button>
  </div>
</header>
<dialog id="rift-map-dialog" class="world-map-dialog journey-map" aria-labelledby="rift-map-title">
  <div class="journey-map-inner">
    <header class="journey-map-heading"><div><p class="journey-eyebrow">ONE RIFT / FIVE DESTINATIONS</p><h2 id="rift-map-title">Where next?</h2></div><button type="button" class="world-close" data-map-close aria-label="Close the Rift map">Close <span aria-hidden="true">×</span></button></header>
    <RiftAtlas surface={surface} />
    <a class="signal-thread" href="/explore#change" data-signal-thread aria-label="Continue exploring a change"><span class="signal-thread-mark" aria-hidden="true">◇</span><span><small data-signal-thread-caption>THE SPACE BETWEEN GAMES</small><strong data-signal-thread-name>Find your signal</strong></span><span aria-hidden="true">↗</span></a>
    <footer class="journey-map-footer"><a href="/explore#change" data-reading-shortcut data-map-explore><span data-reading-subject>Explore a change</span><span aria-hidden="true">↗</span></a><a href={compareHref} data-signal-compare>Compare patches ↗</a><a href="/notebook">Notebook ↗</a><button type="button" data-palette-trigger aria-label="Search the archive">Search</button><button type="button" data-about-open>About RiftScry</button></footer>
  </div>
</dialog>
<noscript><nav class="world-nojs-nav" aria-label="RiftScry destinations">{journeyStations.map(station => <a href={station.href}>{station.label}</a>)}<a href="/notebook">Notebook</a><a href="/explore">Explore a change</a></nav></noscript>
