---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-desktop-light.png';
import { journeyStations, stationForSurface } from '../../lib/journey-stations';
import { getAllPatches } from '../../lib/data';
import RiftAtlas from './RiftAtlas.astro';
import AccountLink from '../account/AccountLink.astro';
interface Props { surface: string }
const { surface } = Astro.props;
const active = stationForSurface(surface);
const section = ['account', 'profile', 'auth'].includes(surface) ? 'account' : ['players', 'next-game'].includes(active) ? 'game' : active === 'pool' ? 'saved' : 'discover';
const patches = getAllPatches();
const compareHref = patches.length > 1 ? `/compare/${patches[0]!.id}/${patches[1]!.id}` : '/patches';
const guideHref = '/guide#' + (['account', 'profile', 'auth'].includes(surface) ? 'account' : active === 'home' ? 'start' : active);
---
<header class="world-controls journey-header" aria-label="RiftScry controls">
  <a class="world-brand" href="/" aria-label="RiftScry home"><Image src={logo} alt="RiftScry" height={40} densities={[1, 2]} loading="eager" /></a>
  <nav class="journey-primary" aria-label="Main navigation">
    <a href="/champions" aria-current={active === 'champions' ? 'page' : undefined}>Champions</a>
    <a href="/patches" aria-current={active === 'patches' ? 'page' : undefined}>Patch notes</a>
    <a href="/next-game" data-station-link="next-game" aria-current={section === 'game' ? 'page' : undefined}>Briefing</a>
    <a href="/pool" aria-current={section === 'saved' ? 'page' : undefined}>Saved <span data-signal-saved-count aria-hidden="true" hidden>0</span></a>
    <a href={guideHref} aria-label="How this page works">Guide</a>
  </nav>
  <div class="world-utilities">
    <AccountLink />
    <button type="button" class="journey-search-trigger" data-palette-trigger aria-label="Search the archive"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><kbd>⌘ K</kbd></button>
    <button type="button" class="theme-choice" data-theme-toggle popovertarget="appearance-panel" aria-haspopup="dialog" aria-controls="appearance-panel" aria-expanded="false" aria-label="Choose theme"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18h1a2 2 0 0 0 1.5-3.3 1.7 1.7 0 0 1 1.3-2.8H18A3 3 0 0 0 21 12a9 9 0 0 0-9-9Z"/><circle cx="7.5" cy="11" r=".8"/><circle cx="10" cy="7" r=".8"/><circle cx="15" cy="7.5" r=".8"/></svg></button>
    <button type="button" class="journey-map-trigger" data-map-open aria-haspopup="dialog" aria-controls="rift-map-dialog" aria-label="Open the Rift map" aria-keyshortcuts="Alt+M"><svg class="journey-menu-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg><span>Menu</span></button>
  </div>
</header>
<div id="appearance-panel" class="appearance-panel" data-appearance-panel popover="auto" role="dialog" aria-labelledby="appearance-title">
  <header><h2 id="appearance-title">Appearance</h2><button type="button" popovertarget="appearance-panel" popovertargetaction="hide" aria-label="Close appearance">×</button></header>
  <fieldset class="appearance-themes"><legend class="sr-only">Theme</legend>
    {[{id:'frost',name:'Frost'},{id:'ember',name:'Ember'},{id:'obsidian',name:'Obsidian'}].map(theme=><label class={`appearance-option appearance-option--${theme.id}`}><input type="radio" name="appearance-theme" value={theme.id} data-theme-choice checked={theme.id==='frost'} disabled/><span class="appearance-preview" aria-hidden="true"><i></i><b>✓</b></span><span>{theme.name}</span></label>)}
  </fieldset>
  <div class="appearance-motion"><span>Reduce motion</span><button type="button" class="motion-choice" data-motion-toggle aria-pressed="false" aria-label="Reduce cinematic motion"><span data-motion-label>Off</span><i aria-hidden="true"></i></button></div>
  <p class="appearance-hint" data-motion-hint>Motion follows your saved preference.</p>
  <p class="sr-only" data-theme-status role="status"></p>
  <noscript><p class="appearance-hint">Theme preferences need JavaScript.</p></noscript>
</div>
<dialog id="rift-map-dialog" class="world-map-dialog journey-map" aria-labelledby="rift-map-title">
  <div class="journey-map-inner">
    <header class="journey-map-heading"><div><p class="journey-eyebrow">ONE RIFT / FIVE DESTINATIONS</p><h2 id="rift-map-title">Where next?</h2></div><button type="button" class="world-close" data-map-close aria-label="Close the Rift map">Close <span aria-hidden="true">×</span></button></header>
    <RiftAtlas surface={surface} />
    <a class="signal-thread" href="/explore#change" data-signal-thread aria-label="Continue exploring a change"><span class="signal-thread-mark" aria-hidden="true">◇</span><span><small data-signal-thread-caption>THE SPACE BETWEEN GAMES</small><strong data-signal-thread-name>Find your signal</strong></span><span aria-hidden="true">↗</span></a>
    <footer class="journey-map-footer"><a href={guideHref}>How this page works ↗</a><a href="/account">My account ↗</a><a href="/explore#change" data-reading-shortcut data-map-explore><span data-reading-subject>Explore a change</span><span aria-hidden="true">↗</span></a><a href={compareHref} data-signal-compare>Compare patches ↗</a><a href="/notebook">Notebook ↗</a><button type="button" data-palette-trigger aria-label="Search the archive">Search</button><button type="button" data-about-open>About RiftScry</button></footer>
  </div>
</dialog>
<noscript><nav class="world-nojs-nav" aria-label="RiftScry destinations">{journeyStations.map(station => <a href={station.href}>{station.label}</a>)}<a href="/notebook">Notebook</a><a href="/explore">Explore a change</a></nav></noscript>
