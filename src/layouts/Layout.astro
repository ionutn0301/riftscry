---
import "../styles/global.css";
import "../styles/experience.css";
import "../styles/connected.css";
import "../styles/observatory-pages.css";
import "../styles/observatory-companion.css";
import "../styles/living-rift.css";
import "../styles/living-readers.css";
import Wayfinder from "../components/experience/Wayfinder.astro";
import RiftScene from "../components/experience/RiftScene.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CommandPalette from "../components/islands/CommandPalette";
import generalUrl from "../assets/fonts/GeneralSans-Variable.woff2?url";
import displayUrl from "../assets/fonts/ClashDisplay-Variable.woff2?url";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  surface?: "home" | "explore" | "next-game" | "notebook" | "champions" | "champion" | "patches" | "patch" | "compare" | "pool" | "players" | "player" | "match" | "missing";
}

const { title, description, ogImage = "/og-default.png", surface: requestedSurface } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const inferredSurface = isHome ? "home" : Astro.url.pathname.split("/")[1] || "missing";
const surface = requestedSurface ?? inferredSurface;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070b13" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={generalUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={displayUrl} crossorigin />
    <link rel="expect" href="#main" blocking="render" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        document.documentElement.dataset.motion = matchMedia('(prefers-reduced-motion: reduce)').matches || localStorage.getItem('riftscry:motion') === 'reduced' ? 'reduced' : 'full';
      } catch { document.documentElement.dataset.motion = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full'; }
      // A saved preference also applies to the browser's document transition.
      const quietCrossing = (event) => {
        const transition = event.viewTransition;
        if (!transition) return;
        // The outgoing document can be hidden before its snapshot is ready.
        // A skipped native transition is an expected visual cancellation.
        void transition.ready.catch((error) => {
          if (error?.name === 'AbortError') return;
          throw error;
        });
        if (document.documentElement.dataset.motion === 'reduced') transition.skipTransition();
      };
      addEventListener('pageswap', quietCrossing);
      addEventListener('pagereveal', quietCrossing);
    </script>
  </head>
  <body class:list={["observatory-shell", "living-rift", (isHome || surface === 'explore') ? "is-home" : "observatory-route"]} data-surface={surface}>
    <a class="skip-link" href="#main">Skip to content</a>
    <RiftScene surface={surface} />
    <div class="rift-site-shell">
      <Wayfinder surface={surface} />
      <main id="main"><slot /></main>
      <SiteFooter />
    </div>
    <CommandPalette client:load />
    <script>
      import '../scripts/experience';
      import '../scripts/living-rift';
    </script>
  </body>
</html>
