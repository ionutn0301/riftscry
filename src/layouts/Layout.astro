---
import "../styles/global.css";
import "../styles/experience-shell.css";
import "../styles/journey-document-flow.css";
import "../styles/rift-atlas.css";
import Wayfinder from "../components/experience/JourneyWayfinder.astro";
import RiftScene from "../components/experience/RiftScene.astro";
import JourneyChrome from "../components/experience/JourneyChrome.astro";
import JourneyChapters from "../components/experience/JourneyChapters.astro";
import CommandPalette from "../components/islands/CommandPalette";
import generalUrl from "../assets/fonts/GeneralSans-Variable.woff2?url";
import displayUrl from "../assets/fonts/ClashDisplay-Variable.woff2?url";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  surface?: "home" | "explore" | "next-game" | "notebook" | "champions" | "champion" | "patches" | "patch" | "compare" | "pool" | "players" | "player" | "match" | "missing";
}

const { title, description, ogImage = "/og-default.png", surface: requestedSurface } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const inferredSurface = isHome ? "home" : Astro.url.pathname.split("/")[1] || "missing";
const surface = requestedSurface ?? inferredSurface;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- The incoming document must opt in before reveal, even while its stylesheets are loading. -->
    <style is:inline>@view-transition { navigation: auto; }</style>
    <meta name="theme-color" content="#070b13" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={generalUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={displayUrl} crossorigin />
    <link rel="expect" href="#main" blocking="render" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        document.documentElement.dataset.motion = matchMedia('(prefers-reduced-motion: reduce)').matches || localStorage.getItem('riftscry:motion') === 'reduced' ? 'reduced' : 'full';
      } catch { document.documentElement.dataset.motion = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full'; }
      // Read native activation metadata rather than intercepting clicks. The
      // browser still owns URLs, modified links, cancellation and Back/Forward.
      const journeyCoordinate = (url) => {
        const parts = new URL(url, location.href).pathname.split('/').filter(Boolean);
        const station = { 'next-game': 1, players: 2, matches: 2, champions: 3, champion: 3, explore: 3, patches: 4, patch: 4, compare: 4, pool: 5, notebook: 5 }[parts[0]] || 0;
        return { station, depth: !station ? 0 : ['champion', 'patch', 'matches', 'compare', 'explore', 'notebook'].includes(parts[0]) || parts.length > 1 ? 2 : 1 };
      };
      // A saved preference also applies to the browser's document transition.
      const quietCrossing = (event) => {
        const transition = event.viewTransition;
        if (!transition) return;
        // Cross-document readiness describes only the optional animation.
        // Hidden documents, interrupted navigation and snapshot timeouts can
        // reject it while the browser still completes the actual navigation.
        void transition.ready.catch(() => {});
        if (document.documentElement.dataset.motion === 'reduced') {
          transition.skipTransition();
          return;
        }
        const activation = event.activation || window.navigation?.activation;
        if (activation?.from?.url && activation?.entry?.url) {
          const from = journeyCoordinate(activation.from.url);
          const to = journeyCoordinate(activation.entry.url);
          document.documentElement.dataset.journeyCrossing = !from.station ? 'enter'
            : !to.station ? 'return'
            : from.station === to.station && from.depth !== to.depth ? to.depth > from.depth ? 'enter' : 'return'
            : to.station < from.station || (activation.navigationType === 'traverse' && activation.entry.index < activation.from.index) ? 'backward' : 'forward';
        }
      };
      addEventListener('pageswap', quietCrossing);
      addEventListener('pagereveal', quietCrossing);
    </script>
  </head>
  <body class:list={["rift-shell", (isHome || surface === 'explore') && "is-home"]} data-surface={surface}>
    <a class="skip-link" href="#main">Skip to content</a>
    <RiftScene surface={surface} />
    <div class="rift-site-shell">
      <Wayfinder surface={surface} />
      <main id="main"><JourneyChapters /><slot /></main>
      <JourneyChrome surface={surface} />
    </div>
    <CommandPalette client:load />
    <script>
      import '../scripts/experience';
      import '../scripts/connected-observatory';
      import '../scripts/signal-continuity';
      import '../scripts/rift-atlas';
    </script>
  </body>
</html>
