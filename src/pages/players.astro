---
import Layout from '../layouts/Layout.astro';
import PlayerGateway from '../components/player/PlayerGateway';
import { platforms } from '../lib/player/contracts';
import '../styles/player.css';
export const prerender = false;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex');
const name = Astro.url.searchParams.get('name')?.slice(0, 150) ?? '';
const platform = Astro.url.searchParams.get('platform')?.toLowerCase() ?? '';
const puuid = Astro.url.searchParams.get('puuid') ?? '';
// Keep previously saved and shared profile links useful after the route split.
if (platform in platforms && /^[A-Za-z0-9_-]{30,120}$/.test(puuid)) {
  const query = new URLSearchParams();
  for (const key of ['name', 'queue', 'champion', 'result', 'view']) {
    const value = Astro.url.searchParams.get(key)?.slice(0, 150);
    if (value) query.set(key, value);
  }
  return Astro.redirect(playerLink(platform, puuid, query.toString()), 302);
}
---
<Layout title="Your next chapter · RiftScry" description="Find a League of Legends player, follow recent matches across modes, and carry useful build decisions into your next game." surface="players">
  <div class="player-workspace player-gateway-shell"><PlayerGateway name={name} platform={platform} client:load /></div>
</Layout>
