---
import Layout from "../../layouts/Layout.astro";
import ChangeCard from "../../components/ChangeCard.astro";
import ClassificationBadge from "../../components/ClassificationBadge.astro";
import DeltaRow from "../../components/DeltaRow.astro";
import PatchFilterBar, { type FilterEntry } from "../../components/islands/PatchFilterBar";
import { getAllPatches, getChampionMeta, getRoles, getLatestPatch } from "../../lib/data";

export function getStaticPaths() {
  return getAllPatches().map((p) => ({ params: { id: p.id }, props: { patch: p } }));
}

const { patch } = Astro.props;
const meta = getChampionMeta();
const roles = getRoles();
const latest = getLatestPatch();
const isLatest = patch.id === latest.id;

const releaseDate = new Date(patch.releaseDate + "T00:00:00Z").toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const entries: FilterEntry[] = patch.champions.map((c) => ({
  id: c.championId,
  name: meta[c.championId]?.name ?? c.championId,
  classification: c.classification,
  roles: roles[c.championId] ?? [],
}));

const counts = {
  buff: patch.champions.filter((c) => c.classification === "buff").length,
  nerf: patch.champions.filter((c) => c.classification === "nerf").length,
};
---

<Layout
  title={`League Patch ${patch.id} Changes — RiftScry`}
  description={`Every champion buff, nerf and adjustment in League of Legends patch ${patch.id}, as structured before/after deltas.`}
>
  <div class="page">
    <header class="patch-header">
      <p class="eyebrow">
        {isLatest ? "Current patch" : "Patch archive"} · {releaseDate} ·
        <a href={patch.sourceUrl}>Official notes ↗</a>
      </p>
      <h1 class="num">{patch.id}</h1>
      <p class="counts">
        <span class="num">{patch.champions.length}</span> champions ·
        <span class="num">{patch.items.length}</span> items ·
        <span class="num">{patch.systems.length}</span> systems
        · <span class="num">{counts.buff}</span> buffed · <span class="num">{counts.nerf}</span> nerfed
      </p>
    </header>

    {patch.hotfixes && patch.hotfixes.length > 0 && (
      <section class="hotfixes" aria-label="Hotfixes">
        <h2>Hotfixes</h2>
        {patch.hotfixes.map((h) => (
          <p><span class="num">{h.date}</span> — {h.description}</p>
        ))}
      </section>
    )}

    <section aria-labelledby="champions-h">
      <div class="section-head">
        <h2 id="champions-h">Champions</h2>
        <p class="shown"><span class="num" data-filter-count>{patch.champions.length}</span> shown</p>
      </div>
      <PatchFilterBar client:load entries={entries} />
      <p class="empty" data-filter-empty hidden>
        No changes match these filters. Loosen one and try again.
      </p>
      <div class="cards">
        {patch.champions.map((c) => (
          <ChangeCard
            change={c}
            meta={meta[c.championId]}
            roles={roles[c.championId] ?? []}
            assetVersion={patch.assetVersion}
          />
        ))}
      </div>
    </section>

    {patch.items.length > 0 && (
      <section aria-labelledby="items-h">
        <h2 id="items-h">Items</h2>
        {patch.items.map((item) => (
          <article class="flat-card">
            <header>
              <h3>{item.name}</h3>
              <ClassificationBadge classification={item.classification} />
            </header>
            {item.changes.map((c) => <DeltaRow change={c} />)}
          </article>
        ))}
      </section>
    )}

    {patch.systems.length > 0 && (
      <section aria-labelledby="systems-h">
        <h2 id="systems-h">Systems</h2>
        {patch.systems.map((sys) => (
          <article class="flat-card">
            <header>
              <h3>{sys.name}</h3>
              <ClassificationBadge classification={sys.classification} />
            </header>
            {sys.changes.map((c) => <DeltaRow change={c} />)}
          </article>
        ))}
      </section>
    )}
  </div>
</Layout>

<style>
  .page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }

  .patch-header {
    padding: var(--s7) 0 var(--s6);
  }

  .eyebrow {
    color: var(--cream-dim);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--s3);
  }

  .eyebrow a {
    color: var(--gold-bright);
  }

  h1 {
    font-family: var(--font-num);
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 1;
    color: var(--cream);
    margin-bottom: var(--s4);
  }

  .counts {
    color: var(--cream-dim);
    font-size: var(--text-sm);
  }

  .counts .num {
    color: var(--cream);
  }

  .hotfixes {
    border: 1px solid var(--gold-deep);
    padding: var(--s4);
    margin-bottom: var(--s6);
  }

  .hotfixes h2 {
    color: var(--gold-bright);
    font-size: var(--text-lg);
    margin-bottom: var(--s2);
  }

  section {
    margin-bottom: var(--s7);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
  }

  h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--s4);
  }

  .shown {
    color: var(--cream-faint);
    font-size: var(--text-sm);
  }

  .empty {
    padding: var(--s6) 0;
    color: var(--cream-dim);
  }

  .flat-card {
    border-top: 1px solid var(--line-strong);
    padding: var(--s4) 0;
  }

  .flat-card header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s2);
  }

  .flat-card h3 {
    font-size: var(--text-lg);
  }
</style>
