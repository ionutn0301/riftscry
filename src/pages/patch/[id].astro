---
import Layout from "../../layouts/Layout.astro";
import "../../styles/journey-readers.css";
import ChangeCard from "../../components/ChangeCard.astro";
import ClassificationBadge from "../../components/ClassificationBadge.astro";
import DeltaRow from "../../components/DeltaRow.astro";
import PatchFilterBar, { type FilterEntry } from "../../components/islands/PatchFilterBar";
import PoolStrip from "../../components/islands/PoolStrip";
import { getAllPatches, getChampionMeta, getRoles, getLatestPatch } from "../../lib/data";

export function getStaticPaths() {
  return getAllPatches().map((patch) => ({ params:{id:patch.id},props:{patch} }));
}
const { patch } = Astro.props;
const meta = getChampionMeta();
const roles = getRoles();
const latest = getLatestPatch();
const isLatest = patch.id === latest.id;
const hotfixes = patch.hotfixes ?? [];
const releaseDate = new Date(patch.releaseDate + "T00:00:00Z").toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric",timeZone:"UTC"});
const entries: FilterEntry[] = patch.champions.map((c) => ({
  id:c.championId,name:meta[c.championId]?.name ?? c.championId,classification:c.classification,roles:roles[c.championId] ?? [],
}));
const counts = {
  buff:patch.champions.filter((c) => c.classification === "buff").length,
  nerf:patch.champions.filter((c) => c.classification === "nerf").length,
};
const names = Object.fromEntries(Object.entries(meta).map(([id,m]) => [id,m.name]));
const changed = Object.fromEntries(patch.champions.map((c) => [c.championId,{
  classification:c.classification,changes:c.abilities.reduce((n,a) => n + a.changes.length,0),
}]));

---
<Layout surface="patch" title={"League Patch " + patch.id + " Changes — RiftScry"} description={"Explore exact champion, item, and system records in archived League of Legends patch " + patch.id + "."}>
  <div class="journey-reader journey-patch" data-journey-deck>
    <header class="journey-reader-header" id="route-arrival"><div><p class="journey-reader-kicker">{isLatest ? "NEWEST ARCHIVED" : "ARCHIVED PATCH"} / {releaseDate}</p><h1>Patch {patch.id}<span class="journey-reader-subtitle">{patch.champions.length} champions · {patch.items.length} items · {patch.systems.length} systems</span></h1></div><div class="journey-header-actions"><a class="journey-quiet-link" href={patch.sourceUrl} target="_blank" rel="noreferrer">Riot’s notes ↗</a><a class="journey-quiet-link" href={"/compare/" + patch.id}>Compare ↗</a></div></header>
    <section id="champions" class="journey-panel journey-patch-champions" data-journey-panel data-journey-label="Champions" data-journey-world="champion" aria-label={"Champion records in patch " + patch.id}>
      <details id="your-perspective" class="journey-disclosure journey-pool-disclosure"><summary>Saved & shared champions</summary><PoolStrip client:load patchId={patch.id} assetVersion={patch.assetVersion} names={names} changed={changed}/><a class="journey-quiet-link" href="/pool#edit-pool">Choose saved champions ↗</a></details>
      <PatchFilterBar client:load entries={entries}/>
      <p class="journey-result-caption">Patch totals: {counts.buff} buffs · {counts.nerf} nerfs</p>
      <p class="journey-empty" data-filter-empty hidden>No matching champions. Change a filter or select Clear filters.</p>
      <div class="journey-patch-browser" data-patch-browser>
        <nav class="journey-record-selector" aria-label="Choose a champion record">{patch.champions.map((champion, index) => <a href={"#" + champion.championId.toLowerCase()} data-patch-select={champion.championId.toLowerCase()} aria-current={index === 0 ? 'true' : undefined}><img src={"https://ddragon.leagueoflegends.com/cdn/" + patch.assetVersion + "/img/champion/" + champion.championId + ".png"} alt="" width="40" height="40" loading="lazy" decoding="async"/><span>{meta[champion.championId]?.name ?? champion.championId}</span><span aria-hidden="true">→</span></a>)}</nav>
        <div class="cards journey-record-canvas" aria-label="Selected champion record">{patch.champions.map((champion) => <ChangeCard change={champion} meta={meta[champion.championId]} roles={roles[champion.championId] ?? []} assetVersion={patch.assetVersion} patchId={patch.id}/>)}</div>
      </div>
    </section>
    {patch.items.length > 0 && <section id="items" class="journey-panel journey-record-list" data-journey-panel data-journey-label="Items" data-journey-world="patch" aria-label={"Item records in patch " + patch.id}>
      <div class="journey-panel-heading"><p class="journey-reader-kicker">{patch.items.length} ITEM RECORDS</p><h2>Inspect the loadout.</h2></div>
      {patch.items.map((item, index) => <details class="journey-record-fold" name="patch-items" open={index === 0}><summary><span>{item.name}</span><ClassificationBadge classification={item.classification}/><span class="journey-fold-plus" aria-hidden="true">+</span></summary><div>{item.changes.map(change => <DeltaRow change={change}/>)}</div></details>)}
    </section>}
    {(patch.systems.length > 0 || hotfixes.length > 0) && <section id="systems" class="journey-panel journey-record-list" data-journey-panel data-journey-label={patch.systems.length ? "Systems & fixes" : "Hotfixes"} data-journey-world="compare" aria-label="System records and hotfixes">
      <div class="journey-panel-heading"><p class="journey-reader-kicker">THE WIDER GAME</p><h2>Rules of the Rift.</h2></div>
      {patch.systems.map((system, index) => <details class="journey-record-fold" name="patch-systems" open={index === 0}><summary><span>{system.name}</span><ClassificationBadge classification={system.classification}/><span class="journey-fold-plus" aria-hidden="true">+</span></summary><div>{system.changes.map(change => <DeltaRow change={change}/>)}</div></details>)}
      {hotfixes.length > 0 && <section id="hotfixes" class="journey-hotfixes"><h2>Hotfixes</h2>{hotfixes.map(hotfix => <article><time datetime={hotfix.date}>{hotfix.date}</time><p>{hotfix.description}</p></article>)}</section>}
    </section>}
  </div>
</Layout>
<script>
  import { presentSelection, releaseSelectionMotion } from '../../lib/selection-motion';

  const browser = document.querySelector<HTMLElement>('[data-patch-browser]');
  if (browser) {
    const cards = [...browser.querySelectorAll<HTMLElement>('[data-champion-id]')];
    const links = [...browser.querySelectorAll<HTMLAnchorElement>('[data-patch-select]')];
    const pane = browser.querySelector<HTMLElement>('.journey-record-canvas');
    const abort = new AbortController();
    const listen = { signal: abort.signal };
    let selected = '';
    const fromHash = () => { try { return decodeURIComponent(location.hash.slice(1)); } catch { return ''; } };
    function selectRecord(id = '') {
      const visible = cards.filter(card => card.dataset.filtered !== 'out');
      const current = visible.find(card => card.id === id) ?? visible.find(card => card.id === selected) ?? visible[0];
      if (current && selected !== current.id) window.dispatchEvent(new CustomEvent('riftscry:focus-change', { detail: { kind: 'champion', key: current.dataset.championId ?? current.id } }));
      selected = current?.id ?? '';
      cards.forEach(card => { card.hidden = card !== current; card.inert = card !== current; });
      links.forEach(link => {
        const card = cards.find(card => card.id === link.dataset.patchSelect);
        link.hidden = !card || card.dataset.filtered === 'out';
        if (link.dataset.patchSelect === selected) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');
      });
      browser!.dataset.recordBrowserReady = 'true';
      presentSelection(pane, selected);
    }
    selectRecord(fromHash());
    const observer = new MutationObserver(() => selectRecord(fromHash()));
    cards.forEach(card => observer.observe(card, { attributes:true, attributeFilter:['data-filtered'] }));
    // Native hash links remain shareable. The global scene controller reveals
    // this panel; selection reveals the exact record within it.
    document.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
      if (!link || link.origin !== location.origin || link.pathname !== location.pathname || link.search !== location.search || !link.hash) return;
      let id = ''; try { id = decodeURIComponent(link.hash.slice(1)); } catch { return; }
      if (cards.some(card => card.id === id)) selectRecord(id);
    }, listen);
    const restore = () => selectRecord(fromHash());
    window.addEventListener('hashchange', restore, listen);
    window.addEventListener('popstate', restore, listen);
    window.addEventListener('riftscry:journey-change', restore, listen);
    window.addEventListener('pagehide', event => {
      if (event.persisted) return;
      observer.disconnect();
      abort.abort();
      releaseSelectionMotion(pane);
    }, listen);
  }
</script>
