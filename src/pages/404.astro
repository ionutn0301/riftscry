---
import Layout from "../layouts/Layout.astro";
import RouteArrival from "../components/experience/RouteArrival.astro";
import { getLatestPatch } from "../lib/data";
const latest = getLatestPatch();
---
<Layout surface="missing" title="Page not found — RiftScry" description="This destination is outside RiftScry. Return home, find your champion, or open the newest archived patch.">
  <div class="reader-experience">
    <RouteArrival eyebrow="404 / SIGNAL LOST" title={"A step\nbeyond the Rift."}
      description="This page isn't here. Return home, or search for what you need."
      variant="missing"
      chapters={[{href:"/champions",label:"Champions"},{href:"/patch/" + latest.id,label:"Patch " + latest.id}]}>
      <div slot="actions"><a class="route-action" href="/">Return home <span aria-hidden="true">↗</span></a><button type="button" class="route-text-link" data-palette-trigger>Search the archive ↗</button></div>
      <span slot="figure" class="reader-missing-code" aria-label="Error 404">404</span>
    </RouteArrival>
  </div>
</Layout>
