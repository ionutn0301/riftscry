---
import Layout from "../layouts/Layout.astro";
import "../styles/signal-readers.css";
import { getLatestPatch } from "../lib/data";
const latest = getLatestPatch();
---
<Layout surface="missing" title="Page not found — RiftScry" description="This destination is outside RiftScry. Return to the observatory or find another signal.">
  <div class="journey-reader journey-missing" data-journey-deck>
    <section id="lost-signal" class="journey-panel journey-lost-panel" data-journey-panel data-journey-label="Find your way" data-journey-world="missing"><div><p class="journey-reader-kicker">404 / SIGNAL LOST</p><h1>A step beyond<br />the Rift.</h1><p>This destination isn’t here.</p><div class="journey-header-actions"><a class="journey-primary-link" href="/">Return to the Rift <span aria-hidden="true">↗</span></a><button type="button" class="journey-quiet-link" data-palette-trigger>Search the archive ↗</button></div><a class="journey-quiet-link" href={"/patch/" + latest.id}>Latest archived patch: {latest.id} ↗</a></div><span class="journey-lost-coordinate" aria-hidden="true">404</span></section>
  </div>
</Layout>
