---
import Layout from "../layouts/Layout.astro";
import RouteArrival from "../components/experience/RouteArrival.astro";
import { getLatestPatch } from "../lib/data";
const latest = getLatestPatch();
---
<Layout surface="missing" title="Page not found — RiftScry" description="This destination is outside the RiftScry archive. Return to the journey, find your champion, or open the newest archived patch.">
  <div class="reader-experience">
    <RouteArrival eyebrow="A PATH OUTSIDE THE ARCHIVE" title={"This trail\nends here."}
      description="The address doesn't lead to a page in this archive. Choose a destination below, or open search to find a champion, patch, item, or system."
      image="/images/voyage/rift-overlook.webp" variant="missing"
      chapters={[{href:"/",label:"Return to the journey",detail:"Start at the overlook"},{href:"/champions",label:"Find your champion",detail:"Explore the complete roster"},{href:"/patch/" + latest.id,label:"Open " + latest.id,detail:"Newest archived patch"}]}>
      <div slot="actions"><a class="route-action" href="/">Return to the journey <span aria-hidden="true">↗</span></a><button type="button" class="route-text-link" data-palette-trigger>Search the archive ↗</button></div>
      <span slot="figure" class="reader-missing-code" aria-label="Error 404">404</span>
    </RouteArrival>
  </div>
</Layout>
