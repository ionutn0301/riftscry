---
import Layout from '../layouts/Layout.astro';
import '../styles/signal-readers.css';
const workflows = [
  { id:'next-game', number:'01', title:'Prepare your next game', intro:'Enter your Riot ID and server. Your briefing brings recent games, relevant patch changes, and your saved focus together.', steps:'Start here before you queue. Choose a game mode, review the available match sample, and carry one useful observation into the next game.', href:'/next-game', action:'Build my briefing', secondary:'/account#riot-id', secondaryLabel:'Associate my Riot ID' },
  { id:'players', number:'02', title:'Review a match', intro:'Find a player to browse their recent matches and the builds they actually played.', steps:'Open a match and choose Review one decision for a short replay routine. Understand this build explains recorded item stats. Both work without sign-in; AI-assisted analysis is optional.', href:'/players', action:'Find my matches', secondary:'/notebook', secondaryLabel:'Open my notebook' },
  { id:'champions', number:'03', title:'Understand champion changes', intro:'Search a champion by name or role and open their patch history.', steps:'Follow exact before-and-after changes, move between archived patches, and save your regular champions to your collection. The archive shows which patches it covers.', href:'/champions', action:'Find a champion', secondary:'/pool#edit-pool', secondaryLabel:'Choose my champions' },
  { id:'patches', number:'04', title:'Read and compare patch notes', intro:'Choose an archived patch to explore its champion, item, and system changes.', steps:'Use Compare to see what changed between two patches. Each patch links to Riot’s original notes so you can check the source.', href:'/patches', action:'Read patch notes', secondary:'/compare', secondaryLabel:'Compare patches' },
  { id:'pool', number:'05', title:'Keep what matters', intro:'Saved holds your champion collection and bookmarked patch findings. Notebook holds your own notes, builds, and match reflections.', steps:'Return to them before you play. Guest saves stay in this browser; sign in and choose Import to copy them into your account for access on other devices.', href:'/pool', action:'Open my collection', secondary:'/notebook', secondaryLabel:'Write a note' },
  { id:'account', number:'06', title:'Make RiftScry yours', intro:'Add a private profile photo, choose a display name and role, and associate a Riot ID. Your AI coach chooses the next-game focus.', steps:'Use Data & sign-in to manage sync, import browser records, export a backup, or sign out. Riot ID association saves your chosen player; it does not verify ownership or require a Riot password.', href:'/account', action:'Open my account', secondary:'/next-game', secondaryLabel:'Open my coach' },
  { id:'catch-up', number:'07', title:'Return after a break', intro:'Choose your champion and the last patch you played. See later archived changes with exact before-and-after records.', steps:'The catch-up shows its coverage and includes links to wider item and system changes. You can bookmark the page URL; no account is required.', href:'/catch-up', action:'Catch me up', secondary:'/learn', secondaryLabel:'Try a champion practice card' },
  { id:'learn', number:'08', title:'Practice one useful habit', intro:'Start with a short practice card for Garen, Lux or Ashe. Understand a sourced mechanic, then try an exercise at your own pace.', steps:'Each card separates Riot’s mechanics from our authored practice prompts and shows its review date. Write your own takeaway in Notebook when you have one.', href:'/learn', action:'Choose a practice card', secondary:'/players', secondaryLabel:'Review my match' },
];
---
<Layout title="How RiftScry works — RiftScry" description="A clear guide to your League of Legends briefing, match review, champion changes, saved notebook, and account.">
  <div class="journey-reader feature-guide" data-journey-deck>
    <section id="start" data-journey-panel data-journey-label="Guide" aria-labelledby="guide-heading">
      <header class="journey-reader-header"><div><p class="journey-reader-kicker">HOW RIFTSCRY WORKS</p><h1 id="guide-heading">A clearer next game.</h1><p class="page-purpose">RiftScry is a League of Legends companion for the time between games. Understand what changed, learn from a match, and decide what to focus on next.</p></div></header>
      <div class="guide-start"><p><strong>New here?</strong> Start with your Riot ID and a briefing. You can explore patch notes and recorded match facts without an account.</p><a href="/next-game">Build my first briefing <span aria-hidden="true">↗</span></a></div>
      <nav class="guide-task-paths" aria-label="Choose what you need"><a href="/next-game"><strong>Before I play</strong><span>My focus and patch catch-up ↗</span></a><a href="/players"><strong>After a match</strong><span>Understand a decision or build ↗</span></a><a href="/catch-up"><strong>Returning to League</strong><span>See what changed since I played ↗</span></a></nav>
      <nav class="guide-index" aria-label="RiftScry features">{workflows.map(item=><a href={'#'+item.id}>{item.number} {item.title}</a>)}</nav>
      <div class="guide-workflows">{workflows.map(item=><section id={item.id} aria-labelledby={'guide-'+item.id}><span class="guide-number" aria-hidden="true">{item.number}</span><div><h2 id={'guide-'+item.id}>{item.title}</h2><p>{item.intro}</p><p class="guide-detail">{item.steps}</p><div class="guide-actions"><a href={item.href}>{item.action} <span aria-hidden="true">↗</span></a><a href={item.secondary}>{item.secondaryLabel} <span aria-hidden="true">↗</span></a></div></div></section>)}</div>
      <section class="guide-access" aria-labelledby="guide-access-title"><h2 id="guide-access-title">What needs an account?</h2><dl><div><dt>Explore as a guest</dt><dd>Champion histories, patch comparisons, available match records, and notes saved in this browser.</dd></div><div><dt>Sign in with Google</dt><dd>AI match analysis, a private profile and photo, Riot ID association, and a workspace that syncs across devices.</dd></div></dl><p>Your signed-in briefing is prepared by AI from recorded evidence. Match facts remain available when AI is unavailable or you browse as a guest.</p></section>
    </section>
  </div>
</Layout>

<style>
.guide-task-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:22px 0}.guide-task-paths a{display:grid;gap:8px;padding:18px;border:1px solid var(--line);border-radius:10px;background:var(--ink-2);color:var(--cream);min-height:88px}.guide-task-paths span{font-size:13px;line-height:1.6;color:var(--cream-dim)}.guide-task-paths a:hover{border-color:var(--world-signal)}@media(max-width:700px){.guide-task-paths{grid-template-columns:1fr}.guide-task-paths a{min-height:74px;padding:14px 16px}}
</style>
