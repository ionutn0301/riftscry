---
import Layout from '../layouts/Layout.astro';
import '../styles/signal-readers.css';
const workflows = [
  { id:'next-game', number:'01', title:'Prepare your next game', intro:'Enter your Riot ID and server. Your briefing brings recent games, relevant patch changes, and your saved focus together.', steps:'Start here before you queue. Choose a game mode, review the available match sample, and carry one useful observation into the next game.', href:'/next-game', action:'Build my briefing', secondary:'/account#riot-id', secondaryLabel:'Associate my Riot ID' },
  { id:'players', number:'02', title:'Review a match', intro:'Find a player to browse their recent matches and the builds they actually played.', steps:'Open a match to inspect its recorded stats, items, and timeline. Sign in to request AI-assisted analysis, then save a useful observation to your notebook.', href:'/players', action:'Find my matches', secondary:'/notebook', secondaryLabel:'Open my notebook' },
  { id:'champions', number:'03', title:'Understand champion changes', intro:'Search a champion by name or role and open their patch history.', steps:'Follow exact before-and-after changes, move between archived patches, and save your regular champions to your collection. The archive shows which patches it covers.', href:'/champions', action:'Find a champion', secondary:'/pool#edit-pool', secondaryLabel:'Choose my champions' },
  { id:'patches', number:'04', title:'Read and compare patch notes', intro:'Choose an archived patch to explore its champion, item, and system changes.', steps:'Use Compare to see what changed between two patches. Each patch links to Riot’s original notes so you can check the source.', href:'/patches', action:'Read patch notes', secondary:'/compare', secondaryLabel:'Compare patches' },
  { id:'pool', number:'05', title:'Keep what matters', intro:'Saved holds your champion collection and bookmarked patch findings. Notebook holds your own notes, builds, and match reflections.', steps:'Return to them before you play. Guest saves stay in this browser; sign in and choose Import to copy them into your account for access on other devices.', href:'/pool', action:'Open my collection', secondary:'/notebook', secondaryLabel:'Write a note' },
  { id:'account', number:'06', title:'Make RiftScry yours', intro:'Add a private profile photo, choose a display name and role, associate a Riot ID, and set practice goals.', steps:'Use Data & sign-in to manage sync, import browser records, export a backup, or sign out. Riot ID association saves your chosen player; it does not verify ownership or require a Riot password.', href:'/account', action:'Open my account', secondary:'/account#practice-plan', secondaryLabel:'Set a practice goal' },
];
---
<Layout title="How RiftScry works — RiftScry" description="A clear guide to your League of Legends briefing, match review, champion changes, saved notebook, and account.">
  <div class="journey-reader feature-guide" data-journey-deck>
    <section id="start" data-journey-panel data-journey-label="Guide" aria-labelledby="guide-heading">
      <header class="journey-reader-header"><div><p class="journey-reader-kicker">HOW RIFTSCRY WORKS</p><h1 id="guide-heading">A clearer next game.</h1><p class="page-purpose">RiftScry is a League of Legends companion for the time between games. Understand what changed, learn from a match, and decide what to focus on next.</p></div></header>
      <div class="guide-start"><p><strong>New here?</strong> Start with your Riot ID and a briefing. You can explore patch notes and recorded match facts without an account.</p><a href="/next-game">Build my first briefing <span aria-hidden="true">↗</span></a></div>
      <nav class="guide-index" aria-label="RiftScry features">{workflows.map(item=><a href={'#'+item.id}>{item.number} {item.title}</a>)}</nav>
      <div class="guide-workflows">{workflows.map(item=><section id={item.id} aria-labelledby={'guide-'+item.id}><span class="guide-number" aria-hidden="true">{item.number}</span><div><h2 id={'guide-'+item.id}>{item.title}</h2><p>{item.intro}</p><p class="guide-detail">{item.steps}</p><div class="guide-actions"><a href={item.href}>{item.action} <span aria-hidden="true">↗</span></a><a href={item.secondary}>{item.secondaryLabel} <span aria-hidden="true">↗</span></a></div></div></section>)}</div>
      <section class="guide-access" aria-labelledby="guide-access-title"><h2 id="guide-access-title">What needs an account?</h2><dl><div><dt>Explore as a guest</dt><dd>Champion histories, patch comparisons, available match records, and notes saved in this browser.</dd></div><div><dt>Sign in with Google</dt><dd>AI match analysis, a private profile and photo, Riot ID association, and a workspace that syncs across devices.</dd></div></dl><p>AI analysis is optional. Recorded match facts remain available without it.</p></section>
    </section>
  </div>
</Layout>
