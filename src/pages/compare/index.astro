---
import { getAllPatches } from "../../lib/data";
import RouteRedirect from "../../components/experience/RouteRedirect.astro";

const patches = getAllPatches();
const target =
  patches.length >= 2 ? `/compare/${patches[0]!.id}/${patches[1]!.id}` : "/patches";
---

<RouteRedirect title="RiftScry — compare patches" target={target} label="the latest comparison" />
