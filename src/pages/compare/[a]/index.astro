---
import { getAllPatches } from "../../../lib/data";
import RouteRedirect from "../../../components/experience/RouteRedirect.astro";

export function getStaticPaths() {
  return getAllPatches().map((p) => ({ params: { a: p.id } }));
}

const { a } = Astro.params;
const patches = getAllPatches();
const current = patches.find((p) => p.id === a)!;
// Default comparison target: the previous patch (or the next-newer if a is oldest).
const idx = patches.findIndex((p) => p.id === a);
const other = patches[idx + 1] ?? patches[idx - 1];
const target = other ? `/compare/${current.id}/${other.id}` : "/patches";
---

<RouteRedirect title={"RiftScry — compare " + a} target={target} label="the comparison" />
