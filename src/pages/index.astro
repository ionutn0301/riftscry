---
import Layout from '../layouts/Layout.astro';
import Observatory from '../components/home/Observatory';
import { getAllPatches, getChampionHistory, getChampionMeta } from '../lib/data';
import type { ObservatoryData } from '../lib/observatory';
import '../styles/observatory.css';
const patches = getAllPatches();
const latest = patches[0]!;
const meta = getChampionMeta();
const ids = [...new Set([...latest.champions.map(c => c.championId), 'Ahri', 'Jinx', 'Thresh', 'LeeSin'])].slice(0, 6);
const data: ObservatoryData = {
  latest: latest.id, date: latest.releaseDate, source: latest.sourceUrl,
  champions: ids.map(id => {
    const entry = getChampionHistory(id)[0];
    return { id, name: meta[id]?.name ?? id, title: meta[id]?.title ?? '', patch: entry?.patchId ?? latest.id, classification: entry?.change.classification ?? 'unchanged', changes: entry?.change.abilities.flatMap(a => a.changes.map(c => c.kind === 'numeric' ? { label: `${a.name} · ${c.label}`, before: c.before, after: c.after } : { label: `${a.name} · ${c.label}`, text: c.text })) ?? [] };
  }),
  patches: patches.slice(0, 8).map(p => ({ id: p.id, date: p.releaseDate, count: p.champions.length }))
};
---
<Layout title="RiftScry — A new perspective on the Rift" description={`An interactive observatory of League of Legends patch ${latest.id}. Explore your champions, inspect every change, and trace the history.`}>
  <Observatory client:load data={data} />
  <noscript><section class="observatory-static"><h1>A new perspective on the Rift.</h1><p>Explore the latest recorded patch, {latest.id}.</p><a href={`/patch/${latest.id}`}>Read patch {latest.id}</a><a href="/pool">Explore champions</a></section></noscript>
</Layout>
