---
import Layout from '../layouts/Layout.astro';
import ObservatoryHome from '../components/experience/ObservatoryHome.astro';
---
<Layout surface="home" title="RiftScry — The Rift is shifting." description="Every patch leaves a signal. Enter a cinematic League of Legends observatory, discover what changed for your champions, and get your personal next-game briefing.">
  <script is:inline>
    // Existing shared journey links and saved reading places still reach their
    // original chapter after the companion becomes the front door.
    const previousJourney = new URL(location.href);
    const journeyChapters = ['#arrival', '#perspective', '#change', '#history', '#return', '#subject', '#evidence', '#ending', '#opening'];
    if (['champion', 'patch', 'older', 'newer', 'event', 'seen', 'beat', 'focus'].some((key) => previousJourney.searchParams.has(key)) || journeyChapters.includes(previousJourney.hash)) {
      location.replace('/explore' + previousJourney.search + previousJourney.hash);
    }
  </script>
  <ObservatoryHome />
</Layout>
