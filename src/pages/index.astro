---
import Layout from '../layouts/Layout.astro';
import SignalJourney from '../components/experience/SignalJourney.astro';
---
<Layout surface="home" title="RiftScry — Read the Rift." description="A League of Legends companion for the space between games. Explore exact champion changes, understand your recent games, and find a useful next move.">
  <script is:inline>
    // Existing shared journey links and saved reading places still reach their
    // original chapter after the companion becomes the front door.
    const previousJourney = new URL(location.href);
    const journeyChapters = ['#perspective', '#change', '#history', '#return', '#subject', '#evidence', '#ending', '#opening'];
    if (['champion', 'patch', 'older', 'newer', 'event', 'seen', 'beat', 'focus'].some((key) => previousJourney.searchParams.has(key)) || journeyChapters.includes(previousJourney.hash)) {
      location.replace('/explore' + previousJourney.search + previousJourney.hash);
    }
  </script>
  <SignalJourney />
</Layout>
