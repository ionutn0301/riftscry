---
import Layout from '../../layouts/Layout.astro';
import MatchReview from '../../components/player/MatchReview';
import '../../styles/player.css';
export const prerender = false;
const id = Astro.params.id ?? '';
const platform = Astro.url.searchParams.get('platform') ?? '';
const puuid = Astro.url.searchParams.get('puuid') ?? '';
const back = Astro.url.searchParams.get('back') ?? '';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex');
---
<Layout title="Match review · RiftScry" description="Recorded match facts, purchase evidence and private Build Memory." surface="players"><div class="player-workspace"><MatchReview id={id} platform={platform} puuid={puuid} back={back} client:load /></div></Layout>
