---
import Layout from "../../layouts/Layout.astro";
import "../../styles/signal-readers.css";
import SignalRecord from "../../components/experience/SignalRecord.astro";
import ClassificationBadge from "../../components/ClassificationBadge.astro";
import SaveChampion from "../../components/experience/SaveChampion.astro";
import { getAllPatches, getChampionHistory, getChampionMeta, getRoles, getLatestPatch } from "../../lib/data";
import { assetFor } from "../../lib/investigation";

export function getStaticPaths() {
  return Object.keys(getChampionMeta()).map((championId) => ({ params:{ slug:championId.toLowerCase() }, props:{ championId } }));
}
const { championId } = Astro.props;
const meta = getChampionMeta()[championId]!;
const roles = getRoles()[championId] ?? [];
const history = getChampionHistory(championId);
const patches = getAllPatches();
const latest = getLatestPatch();
const artwork = assetFor(championId);
const counts = {
  buff:history.filter((h) => h.change.classification === "buff").length,
  nerf:history.filter((h) => h.change.classification === "nerf").length,
  other:history.filter((h) => !["buff","nerf"].includes(h.change.classification)).length,
};
const roleLabels: Record<string,string> = { top:"Top",jungle:"Jungle",mid:"Mid",adc:"ADC",support:"Support" };
const journeyUrl = "/explore?champion=" + encodeURIComponent(championId) + "#change";
---
<Layout surface="champion" title={meta.name + " Patch History — RiftScry"} description={"Move through " + meta.name + "’s exact archived changes, with original patch sources."}>
  <div class="journey-reader journey-champion" data-journey-deck>
    <header class="journey-reader-header" id="route-arrival"><div><p class="journey-reader-kicker">CHAMPION / {roles.map(role => roleLabels[role]).join(" · ")}</p><h1>{meta.name}<span class="journey-reader-subtitle">{meta.title}</span></h1></div><div class="journey-header-actions"><SaveChampion id={championId} name={meta.name} /><a class="journey-quiet-link" href="/champions">Change champion <span aria-hidden="true">↗</span></a></div></header>
    <section id="history" class="journey-panel journey-champion-panel" data-journey-panel data-journey-label="Patch history" data-journey-world="champion" aria-label={meta.name + " patch history"}>
      <figure class="journey-champion-art" data-champion-art><picture><img data-champion-art-image src={artwork.splash || artwork.portrait} alt={meta.name + ", official Riot Games champion artwork"} width="1215" height="717" loading="eager" decoding="async" /></picture><div class="journey-champion-art-fallback" data-champion-art-fallback hidden><strong>{meta.name}</strong><span>Artwork unavailable</span></div><figcaption data-champion-art-credit>RIOT GAMES / ORIGINAL ARTWORK</figcaption></figure>
      <div class="journey-history-stage" data-history-stage data-signal-subject={championId} data-signal-name={meta.name}>
        {history.length ? <>
          <nav class="journey-history-stops" aria-label={meta.name + " recorded patches"}>{history.map((entry, index) => <a href={"#record-" + entry.patchId.replaceAll(".", "-")} data-history-select={entry.patchId} aria-current={index === 0 ? 'true' : undefined}><span>{entry.patchId}</span><time datetime={entry.releaseDate}>{new Date(entry.releaseDate + "T00:00:00Z").toLocaleDateString('en', { month:'short', day:'numeric', timeZone:'UTC' })}</time></a>)}</nav>
          <div class="journey-history-records">
            {history.map(entry => <article id={"record-" + entry.patchId.replaceAll(".", "-")} class="journey-history-record" data-history-record={entry.patchId} data-signal-subject={championId} data-signal-name={meta.name} data-signal-patch={entry.patchId} tabindex="-1">
              <header class="journey-record-heading"><div><p class="journey-reader-kicker">{entry.releaseDate}</p><h2>Patch {entry.patchId}</h2></div><ClassificationBadge classification={entry.change.classification} /></header>
              <SignalRecord label={meta.name} championId={championId} patchId={entry.patchId} sourceUrl={patches.find(patch => patch.id === entry.patchId)?.sourceUrl} inspectHref={journeyUrl}
                entries={entry.change.abilities.flatMap(ability => ability.changes.map(change => ({change, ability:ability.ability, abilityName:ability.name})))} />
              {entry.change.summary && <details class="journey-source-context"><summary>Riot’s context</summary><p class="journey-record-summary">{entry.change.summary}</p></details>}
              <div class="journey-record-links"><a href={"/patch/" + entry.patchId + "#" + championId.toLowerCase()}>Open in patch {entry.patchId} ↗</a></div>
            </article>)}
          </div>
        </> : <div class="journey-empty"><h2>No direct records yet.</h2><p>{meta.name} has no direct champion changes in this archive. Items and systems can still affect the game.</p><a class="journey-primary-link" href={"/patch/" + latest.id}>Explore patch {latest.id} ↗</a></div>}
      </div>
    </section>
    <section id="perspective" class="journey-panel journey-source-panel" data-journey-panel data-journey-label="Coverage & sources" data-journey-short-label="Sources" data-journey-world="explore"><div><p class="journey-reader-kicker">THE RECORD / IN CONTEXT</p><h2>Every change has a source.</h2><p>Direct champion records from {patches.at(-1)!.releaseDate} through {latest.releaseDate}. This archive does not reconstruct a live stat sheet.</p><dl class="journey-source-counts"><div><dt>Buff records</dt><dd>{counts.buff}</dd></div><div><dt>Nerf records</dt><dd>{counts.nerf}</dd></div><div><dt>Other records</dt><dd>{counts.other}</dd></div></dl><p>These labels describe the source records, not current champion strength. Roles are curated.</p><div class="journey-record-links"><a href={journeyUrl}>Explore {meta.name} ↗</a><a href="https://github.com/ionutn0301/riftscry/blob/main/CONTRIBUTING.md">Suggest a correction ↗</a></div></div></section>
  </div>
</Layout>
<script>
  import { rememberSignal } from '../../lib/signal-context';

  const art = document.querySelector<HTMLImageElement>('[data-champion-art-image]');
  const artFallback = document.querySelector<HTMLElement>('[data-champion-art-fallback]');
  const artCredit = document.querySelector<HTMLElement>('[data-champion-art-credit]');
  if (art && artFallback) {
    function updateArtworkAvailability() {
      const available = art!.naturalWidth > 0;
      art!.hidden = !available;
      artFallback!.hidden = available;
      if (artCredit) artCredit.hidden = !available;
    }
    art.addEventListener('load', updateArtworkAvailability);
    art.addEventListener('error', updateArtworkAvailability);
    if (art.complete) updateArtworkAvailability();
  }
  const stage = document.querySelector<HTMLElement>('[data-history-stage]');
  if (stage) {
    const records = [...stage.querySelectorAll<HTMLElement>('[data-history-record]')];
    const links = [...stage.querySelectorAll<HTMLAnchorElement>('[data-history-select]')];
    let selectedRecord = '';
    function selectRecord(id: string) {
      const current = records.find(record => record.id === id) ?? records.find(record => record.dataset.historyRecord === id);
      if (!current) return;
      const changed = selectedRecord !== current.id;
      selectedRecord = current.id;
      records.forEach(record => { record.hidden = record !== current; record.inert = record !== current; });
      links.forEach(link => { if (link.dataset.historySelect === current.dataset.historyRecord) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current'); });
      const key = current.dataset.signalSubject;
      if (key) rememberSignal({ championId: key, name: current.dataset.signalName ?? key, patch: current.dataset.signalPatch, href: location.pathname + location.search + '#' + current.id });
      if (changed) window.dispatchEvent(new CustomEvent('riftscry:focus-change', { detail: { kind: 'patch', key: current.dataset.historyRecord ?? current.id } }));
    }
    function restore() {
      let id = ''; try { id = decodeURIComponent(location.hash.slice(1)); } catch {}
      // Other scene fragments retain the current patch. On first arrival an
      // exact record fragment wins before any default record is announced.
      const requested = records.find(record => record.id === id || record.dataset.historyRecord === id);
      selectRecord(requested?.id || selectedRecord || records[0]?.id || '');
    }
    if (records.length) {
      stage.dataset.historyReady = 'true';
      restore();
      stage.addEventListener('click', event => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('[data-history-select]');
        if (link && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey && event.button === 0) selectRecord(link.hash.slice(1));
      });
      window.addEventListener('hashchange', restore);
      window.addEventListener('popstate', restore);
      window.addEventListener('riftscry:journey-change', restore);
    } else {
      const key = stage.dataset.signalSubject;
      if (key) rememberSignal({ championId: key, name: stage.dataset.signalName ?? key, href: location.pathname + location.search });
    }
  }
</script>
