---
import Layout from "../../layouts/Layout.astro";
import { getAssetVersion, getChampionHistory, getChampionMeta } from "../../lib/data";

const meta = getChampionMeta();
const assetVersion = getAssetVersion();
const champions = Object.entries(meta)
  .map(([id, m]) => ({ id, ...m, changes: getChampionHistory(id).length }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title="Champions — RiftScry"
  description="Season-long patch history for every League of Legends champion: buffs, nerfs and adjustments as structured data."
>
  <div class="page">
    <p class="eyebrow">THE CHAMPION ARCHIVE</p>
    <h1>Pick a main. See its history.</h1>
    <p class="intro">Every champion. Every recorded shift. Explore the changes behind your next game.</p>
    <ul class="grid">
      {
        champions.map((c) => (
          <li>
            <a href={`/champion/${c.id.toLowerCase()}`}>
              <img
                src={`https://ddragon.leagueoflegends.com/cdn/${assetVersion}/img/champion/${c.id}.png`}
                alt=""
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
              />
              <span class="name">{c.name}</span>
              <span class="changes num">
                {c.changes > 0 ? `${c.changes} ${c.changes === 1 ? "patch" : "patches"}` : "untouched"}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  .page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--s7) var(--page-pad) 0;
  }

  h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--s3);
  }
  .eyebrow { color: var(--cream-dim); font-size: var(--text-xs); letter-spacing: .16em; margin-bottom: var(--s3); }
  .intro { color: var(--cream-dim); max-width: 60ch; margin-bottom: var(--s6); }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: var(--s3);
  }

  .grid a {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    padding: var(--s4);
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold-deep);
    background: var(--ink-2);
    box-shadow: 0 3px 12px #25372d08;
    transition:
      border-color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .grid a:hover {
    border-color: var(--gold-deep);
    background: var(--ink-2);
    color: inherit;
  }

  .grid img {
    width: 48px;
    height: 48px;
    border: 1px solid var(--line-strong);
  }

  .name {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .changes {
    font-size: var(--text-xs);
    color: var(--cream-faint);
  }
</style>
