---
import Layout from "../../layouts/Layout.astro";
import "../../styles/signal-readers.css";
import { getAssetVersion, getChampionHistory, getChampionMeta, getLatestPatch, getRoles, ROLES } from "../../lib/data";
import { assetFor } from "../../lib/investigation";

const meta = getChampionMeta();
const roles = getRoles();
const latest = getLatestPatch();
const assetVersion = getAssetVersion();
const champions = Object.entries(meta).map(([id, m]) => {
  const history = getChampionHistory(id);
  return { id, ...m, changes: history.length, latest: history[0]?.patchId, roles: roles[id] ?? [] };
}).sort((a,b) => a.name.localeCompare(b.name));
const featured = latest.champions.slice(0,3).flatMap((c) => {
  const champion = champions.find((item) => item.id === c.championId);
  return champion ? [champion] : [];
});
const spotlight = featured[0] ?? champions[0]!;
const featuredIds = new Set(latest.champions.slice(0, 12).map(change => change.championId));
const normalize = (value: string) => value.normalize("NFKD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9]/g,"");
const roleLabels: Record<string,string> = { top:"Top",jungle:"Jungle",mid:"Mid",adc:"ADC",support:"Support" };
---
<Layout surface="champions" title="Champions — RiftScry" description="Choose a champion. Move through exact patch records in the RiftScry observatory.">
  <div class="journey-reader journey-roster" data-journey-deck data-roster-directory>
    <header class="journey-reader-header" id="route-arrival">
      <div><p class="journey-reader-kicker">CHAMPIONS / {champions.length} PERSPECTIVES</p><h1>Find your champion.</h1></div>
      <a class="journey-quiet-link" href="/pool#briefing">Saved champions <span aria-hidden="true">↗</span></a>
    </header>
    <form class="roster-tools journey-roster-tools" data-roster-tools hidden>
      <div class="roster-search"><label for="roster-search">Find a champion</label><input id="roster-search" data-roster-search type="search" placeholder="Champion name…" autocomplete="off" spellcheck="false" /></div>
      <div class="roster-role-options" role="group" aria-label="Champion role"><button type="button" data-roster-role="" aria-pressed="true">All</button>{ROLES.map((role) => <button type="button" data-roster-role={role} aria-pressed="false">{roleLabels[role]}</button>)}</div>
      <button type="button" class="journey-quiet-link" data-roster-reset hidden>Clear</button>
    </form>
    <section id="roster" class="journey-panel journey-roster-panel" data-journey-panel data-journey-label="Find a champion" data-journey-world="champions" aria-label="Champion roster">
      <div class="roster-lens journey-roster-lens" data-reader-champion-lens="arrival" data-reader-key={spotlight.id}>
        <figure>
          <div class="roster-lens-media" data-reader-lens-media><img data-reader-champion-art src={assetFor(spotlight.id).splash} alt={spotlight.name + " — official Riot Games artwork"} width="1215" height="717" loading="eager" decoding="async" /><p class="roster-lens-fallback" data-reader-art-fallback hidden>Artwork unavailable. Champion records are still available.</p></div>
          <figcaption><div><strong data-reader-champion-name>{spotlight.name}</strong><span data-reader-champion-title>{spotlight.title}</span></div><a class="reader-lens-open" data-reader-champion-link href={"/champion/" + spotlight.id.toLowerCase()}>Enter history <span aria-hidden="true">↗</span></a></figcaption>
        </figure>
        <p class="reader-lens-record" data-reader-champion-record>{spotlight.changes ? "Latest " + spotlight.latest + " · " + spotlight.changes + " archived " + (spotlight.changes === 1 ? "patch" : "patches") : "No direct records yet"}</p>
        <p class="journey-art-credit">RIOT GAMES ARTWORK · ARCHIVE THROUGH {latest.releaseDate}</p>
      </div>
      <div class="journey-roster-results">
        <div class="roster-results-bar"><p><span data-roster-count aria-live="polite">{champions.length}</span> champions in focus</p><button type="button" data-roster-expand aria-controls="roster-wall" aria-expanded="false">View all {champions.length} champions ↗</button></div>
        <p class="journey-empty" data-roster-empty hidden>No matches. Try another name or clear the filters.</p>
        <ul id="roster-wall" class="roster-wall journey-casting-wall">
          {champions.map((c) => <li class="roster-entry" data-roster-row data-roster-featured={featuredIds.has(c.id) ? "true" : undefined} data-roster-key={c.id} data-signal-subject={c.id} data-signal-name={c.name} data-signal-patch={c.latest} data-roster-name={c.name} data-roster-title={c.title} data-roster-latest={c.latest ?? ""} data-roster-changes={c.changes} data-roster-splash={assetFor(c.id).splash} data-roster-query={normalize(c.id + " " + c.name)} data-roster-roles={c.roles.join(",")} data-reader-active={c.id === spotlight.id ? "true" : undefined}>
            <a href={"/champion/" + c.id.toLowerCase()}><span class="roster-portrait"><img src={"https://ddragon.leagueoflegends.com/cdn/" + assetVersion + "/img/champion/" + c.id + ".png"} alt="" width="48" height="48" loading="lazy" decoding="async" /></span><span class="roster-entry-copy"><span class="name">{c.name}</span><span class="roster-entry-roles">{c.roles.map(role => roleLabels[role]).join(" / ")}</span></span><span class="roster-arrow" aria-hidden="true">↗</span></a>
          </li>)}
        </ul>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '../../scripts/reader-lens';

  function initRoster() {
    const root = document.querySelector<HTMLElement>("[data-roster-directory]");
    if (!root || root.dataset.rosterReady) return;
    root.dataset.rosterReady = "true";
    const tools = root.querySelector<HTMLFormElement>("[data-roster-tools]")!;
    const search = root.querySelector<HTMLInputElement>("[data-roster-search]")!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-roster-role]")];
    const rows = [...root.querySelectorAll<HTMLElement>("[data-roster-row]")];
    const count = root.querySelector<HTMLElement>("[data-roster-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-roster-empty]")!;
    const expand = root.querySelector<HTMLButtonElement>("[data-roster-expand]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-roster-reset]")!;
    let role = "";
    let expanded = false;
    const normal = (value: string) => value.normalize("NFKD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9]/g,"");
    function apply(sync = true) {
      const query = normal(search.value);
      let shown = 0;
      for (const row of rows) {
        const match = (!query || (row.dataset.rosterQuery ?? "").includes(query)) && (!role || (row.dataset.rosterRoles ?? "").split(",").includes(role)) && (Boolean(query || role || expanded) || row.dataset.rosterFeatured === "true");
        row.hidden = !match;
        if (match) shown++;
      }
      count.textContent = String(shown);
      empty.hidden = shown > 0;
      expand.hidden = Boolean(query || role);
      expand.setAttribute("aria-expanded", String(expanded));
      expand.textContent = expanded ? "Show recent changes" : "View all " + rows.length + " champions ↗";
      reset.hidden = !query && !role;
      for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.rosterRole === role));
      if (sync) {
        const url = new URL(location.href);
        if (search.value.trim()) url.searchParams.set("q",search.value.trim()); else url.searchParams.delete("q");
        if (role) url.searchParams.set("role",role); else url.searchParams.delete("role");
        history.replaceState(null,"",url.pathname + url.search + url.hash);
      }
      root?.dispatchEvent(new Event("riftscry:roster-filtered"));
    }
    function restore() {
      const params = new URLSearchParams(location.search);
      search.value = params.get("q") ?? "";
      role = buttons.some((button) => button.dataset.rosterRole === params.get("role")) ? params.get("role")! : "";
      apply(false);
    }
    tools.hidden = false;
    tools.addEventListener("submit",(event) => event.preventDefault());
    search.addEventListener("input",() => apply());
    expand.addEventListener("click", () => { expanded = !expanded; apply(false); });
    for (const button of buttons) button.addEventListener("click",() => { role = button.dataset.rosterRole === role ? "" : button.dataset.rosterRole ?? ""; apply(); });
    reset.addEventListener("click",() => { search.value = ""; role = ""; apply(); search.focus(); });
    window.addEventListener("popstate",restore);
    restore();
  }
  initRoster();
  document.addEventListener("astro:page-load",initRoster);
</script>
