---
import Layout from "../layouts/Layout.astro";
import "../styles/signal-readers.css";
import ReturnBriefing from "../components/experience/ReturnBriefing.astro";
import KeptFindings from "../components/experience/KeptFindings";
import PoolPicker, { type PoolChampion } from "../components/islands/PoolPicker";
import { getAssetVersion, getChampionMeta, getLatestPatch, getRoles } from "../lib/data";
const meta = getChampionMeta();
const roles = getRoles();
const assetVersion = getAssetVersion();
const latest = getLatestPatch();
const champions: PoolChampion[] = Object.entries(meta).map(([id,m]) => ({id,name:m.name,title:m.title,roles:roles[id] ?? []})).sort((a,b) => a.name.localeCompare(b.name));
---
<Layout surface="pool" title="Saved champions — RiftScry" description="Your champions and kept findings. Return to the records that matter to you.">
  <div class="journey-reader journey-saved" data-journey-deck>
    <header class="journey-reader-header" id="route-arrival"><div><p class="journey-reader-kicker">SAVED / ON THIS DEVICE</p><h1>Your corner of the Rift.</h1></div><div class="journey-header-actions"><a class="journey-quiet-link" href="/notebook">Notebook ↗</a><a class="journey-quiet-link" href="/next-game">Automatic briefing ↗</a></div></header>
    <section id="briefing" class="journey-panel journey-saved-panel" data-journey-panel data-journey-label="Saved champions" data-journey-world="pool" aria-label="Saved champions"><ReturnBriefing compact heading="Your saved champions" /></section>
    <section id="findings" class="journey-panel journey-saved-panel" data-journey-panel data-journey-label="Findings" data-journey-world="pool" aria-label="Kept findings"><KeptFindings client:load /></section>
    <section id="edit-pool" class="journey-panel journey-saved-panel" data-journey-panel data-journey-label="Choose champions" data-journey-world="champions" aria-label="Choose saved champions"><div class="journey-panel-heading"><p class="journey-reader-kicker">YOUR PERSPECTIVE</p><h2>Keep your champions close.</h2><p>Tap to save. Tap again to remove.</p></div><PoolPicker client:load champions={champions} assetVersion={assetVersion} latestPatchId={latest.id}/></section>
  </div>
</Layout>
