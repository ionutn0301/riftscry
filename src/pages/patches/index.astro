---
import Layout from "../../layouts/Layout.astro";
import "../../styles/signal-readers.css";
import { getAllPatches } from "../../lib/data";
const patches = getAllPatches();
const latest = patches[0]!;
const earliest = patches.at(-1)!;
const chronological = [...patches].reverse();
const entryCount = (patch: typeof latest) => patch.champions.length + patch.items.length + patch.systems.length;
const largestEntryCount = Math.max(1, ...patches.map(entryCount));
const firstDate = Date.parse(earliest.releaseDate + "T00:00:00Z");
const dateSpan = Math.max(1, Date.parse(latest.releaseDate + "T00:00:00Z") - firstDate);
function fmt(date: string) { return new Date(date + "T00:00:00Z").toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric",timeZone:"UTC"}); }
---
<Layout surface="patches" title="Patch archive — RiftScry" description="Move between the Rift’s recorded moments. Choose a patch to reveal its exact changes.">
  <div class="journey-reader journey-patch-directory" data-journey-deck data-patch-directory>
    <header class="journey-reader-header" id="route-arrival"><div><p class="journey-reader-kicker">PATCHES / {patches.length} RECORDED MOMENTS</p><h1>Move through time.</h1></div><a class="journey-quiet-link" href="/compare">Compare two patches <span aria-hidden="true">↗</span></a></header>
    <section id="archive" class="journey-panel journey-archive-panel" data-journey-panel data-journey-label="Choose a patch" data-journey-world="patches" aria-label="Patch archive">
      <figure class="archive-instrument" data-archive-instrument data-reader-key={latest.id} aria-label={"Archive from patch " + earliest.id + " through " + latest.id}>
        <figcaption><span>PATCH IN FOCUS</span><span data-archive-gesture>THE ARCHIVE</span></figcaption>
        <div class="archive-instrument-current"><strong data-archive-focus-id>{latest.id}</strong><time data-archive-focus-date datetime={latest.releaseDate}>{fmt(latest.releaseDate)}</time></div>
        <div class="archive-timeline" data-archive-timeline>
        <svg data-archive-timeline-chart viewBox="0 0 560 150" preserveAspectRatio="none" role="img" aria-label="Archived patches positioned by release date. Column height counts champion, item, and system entries."><line class="archive-baseline" x1="10" y1="140" x2="550" y2="140" />{chronological.map(patch => {
          const x = 14 + ((Date.parse(patch.releaseDate + "T00:00:00Z") - firstDate) / dateSpan) * 532;
          const height = (entryCount(patch) / largestEntryCount) * 120;
          return <g data-reader-patch-bar={patch.id} data-reader-active={patch.id === latest.id ? "true" : undefined}><rect x={x - 4} y={140 - height} width="8" height={height} /><line x1={x} y1={140 - height - 5} x2={x} y2={145} /></g>;
        })}<g class="archive-time-cursor" data-archive-cursor transform="translate(546 0)" aria-hidden="true"><line x1="0" x2="0" y1="7" y2="146"/><path d="m0 0 4 4-4 4-4-4Z"/><path d="m-5 150 5-5 5 5"/></g></svg>
        <input type="range" data-archive-scrubber hidden min="0" max={chronological.length - 1} step="1" value={chronological.length - 1} aria-label="Select an archived patch" aria-valuetext={`Patch ${latest.id}, ${fmt(latest.releaseDate)}`} aria-describedby="archive-count-meaning" />
        </div>
        <div class="archive-instrument-axis"><time datetime={earliest.releaseDate}>{earliest.releaseDate}</time><time datetime={latest.releaseDate}>{latest.releaseDate}</time></div>
        <dl class="archive-instrument-counts"><div><dt>Champions</dt><dd data-archive-count="champions">{latest.champions.length}</dd></div><div><dt>Items</dt><dd data-archive-count="items">{latest.items.length}</dd></div><div><dt>Systems</dt><dd data-archive-count="systems">{latest.systems.length}</dd></div></dl>
        <a class="reader-lens-open journey-primary-link" data-archive-focus-link href={"/patch/" + latest.id}>Enter patch <span data-archive-link-id>{latest.id}</span><span aria-hidden="true">↗</span></a>
        <p class="archive-instrument-note" id="archive-count-meaning">Columns count entries, not impact. Archive dates are shown above.</p>
      </figure>
      <ol class="patch-list patch-chronology journey-patch-stops" reversed aria-label="Choose a recorded patch">
        {patches.map((patch,index) => <li data-reader-patch-key={patch.id} data-patch-date={patch.releaseDate} data-champions={patch.champions.length} data-items={patch.items.length} data-systems={patch.systems.length} data-reader-active={index === 0 ? "true" : undefined}><a href={"/patch/" + patch.id}><span><span class="pid">{patch.id}</span><time class="date" datetime={patch.releaseDate}>{fmt(patch.releaseDate)}</time></span><span class="journey-patch-stop-meta">{index === 0 ? "NEWEST ARCHIVED" : `${entryCount(patch)} ENTRIES`}</span><span class="patch-enter" aria-hidden="true">↗</span></a></li>)}
      </ol>
    </section>
  </div>
</Layout>
<script>
  import '../../scripts/reader-lens';
</script>
