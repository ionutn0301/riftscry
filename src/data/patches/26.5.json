    {
      "championId": "Samira",
      "classification": "adjustment",
      "summary": "We’re giving Samira some love in the form of QoL and minor bugfixing around her Q!",
      "abilities": [
        {
          "ability": "Q",
          "name": "Flair",
          "changes": [
            {
              "kind": "prose",
              "label": "The Right Tool for the Job",
              "text": "Samira Q will now do multiple additional checks to see if there are units on both the right and left of her. If there are, and importantly if there are no units far in front of her, she will use Sword Q. If a unit is far in front of her, she will still use Gun Q regardless of units on the right and left."
            },
            {
              "kind": "prose",
              "label": "Itchy Trigger Finger",
              "text": "Samira Q is now properly sealed during her passive. This resolves a case where Samira Q can go on cooldown despite not being used if pressed during her passive’s animation. This also applies to an instance where her ultimate was cast after her W."
            },
            {
              "kind": "prose",
              "label": "Can’t Out-Walk Me",
              "text": "Samira Q will now do a check to see if the enemy is walking away from her and in the very last part of her Sword Q’s range. If so, she will instead use Gun Q. This should resolve the extreme cases where champions can simply walk away from her Q at very low move speed (higher move speeds will still likely be able to do so, rightfully.)"
            }
          ]
        }
      ]
    },
